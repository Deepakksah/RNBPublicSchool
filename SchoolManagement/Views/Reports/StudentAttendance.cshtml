@model SchoolManagement.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Student Attendance Report";
    var reportData = ViewBag.ReportData as List<SchoolManagement.ViewModels.StudentAttendanceReportItem> ?? new();
    int pageIndex = ViewBag.PageIndex ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-3 border-bottom no-print">
    <div>
        <h4 class="fw-bold mb-1">Student Attendance Report</h4>
        <p class="text-muted small mb-0">Total Records: <strong>@totalCount.ToString("N0")</strong> | Period: <strong>@Model.DateFrom.ToString("dd MMM yyyy")</strong> to <strong>@Model.DateTo.ToString("dd MMM yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="ExportExcel" asp-route-reportType="StudentAttendance" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
        <a asp-action="ExportCsv" asp-route-reportType="StudentAttendance" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-file-earmark-text"></i> CSV
        </a>
        <button onclick="window.print()" class="btn btn-light border btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-printer"></i> Print Report
        </button>
    </div>
</div>

<!-- Print Header -->
<div class="print-header">
    <h2>Student Attendance Comprehensive Report</h2>
    <p>Date Range: @Model.DateFrom.ToString("dd MMM yyyy") to @Model.DateTo.ToString("dd MMM yyyy")</p>
</div>

<!-- Filter Box -->
<div class="card card-custom p-3 mb-3 no-print">
    <form method="get" asp-action="StudentAttendance" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Class</label>
            <select asp-for="ClassId" asp-items="Model.Classes" class="form-select form-select-sm" id="filterClassSelect">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Section</label>
            <select asp-for="SectionId" asp-items="Model.Sections" class="form-select form-select-sm" id="filterSectionSelect">
                <option value="">-- All Sections --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">From Date</label>
            <input asp-for="DateFrom" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">To Date</label>
            <input asp-for="DateTo" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Generate</button>
            <a asp-action="StudentAttendance" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Report Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Roll No</th>
                    <th>Adm. No</th>
                    <th>Student Name</th>
                    <th>Class - Sec</th>
                    <th>Total Days</th>
                    <th>Present</th>
                    <th>Absent</th>
                    <th>Leave</th>
                    <th>Attendance %</th>
                </tr>
            </thead>
            <tbody>
                @if (reportData.Any())
                {
                    @foreach (var r in reportData)
                    {
                        <tr>
                            <td class="fw-bold">@r.RollNumber</td>
                            <td><span class="badge bg-light text-secondary border">@r.AdmissionNumber</span></td>
                            <td class="fw-semibold">@r.StudentName</td>
                            <td>@r.ClassName - @r.SectionName</td>
                            <td>@r.TotalWorkingDays</td>
                            <td><span class="badge bg-success-subtle text-success">@r.PresentDays</span></td>
                            <td><span class="badge bg-danger-subtle text-danger">@r.AbsentDays</span></td>
                            <td>@r.LeaveDays</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 50px;">
                                        <div class="progress-bar @(r.AttendancePercentage >= 75 ? "bg-success" : "bg-danger")" style="width: @r.AttendancePercentage%"></div>
                                    </div>
                                    <span class="fw-bold small">@r.AttendancePercentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-5 text-muted">No attendance data found for the selected parameters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-center py-3 gap-2 no-print">
            <span class="text-muted small">
                Showing page <strong>@pageIndex</strong> of <strong>@totalPages</strong> (Total: <strong>@totalCount.ToString("N0")</strong> students)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="StudentAttendance" asp-route-page="1" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">&laquo; First</a>
                </li>
                <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="StudentAttendance" asp-route-page="@(pageIndex - 1)" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">Prev</a>
                </li>
                @{
                    int startPage = Math.Max(1, pageIndex - 2);
                    int endPage = Math.Min(totalPages, pageIndex + 2);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == pageIndex ? "active" : "")">
                        <a class="page-link" asp-action="StudentAttendance" asp-route-page="@i" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">@i</a>
                    </li>
                }
                <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="StudentAttendance" asp-route-page="@(pageIndex + 1)" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">Next</a>
                </li>
                <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="StudentAttendance" asp-route-page="@totalPages" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">Last &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

<div class="print-footer-signatures">
    <div>
        ____________________________<br />
        Prepared By
    </div>
    <div>
        ____________________________<br />
        Principal / Authorized Seal
    </div>
</div>
