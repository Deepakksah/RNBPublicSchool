@model SchoolManagement.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Teacher Attendance Report";
    var reportData = ViewBag.ReportData as List<SchoolManagement.ViewModels.TeacherAttendanceReportItem> ?? new();
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom no-print">
    <div>
        <h4 class="fw-bold mb-1">Faculty & Staff Attendance Report</h4>
        <p class="text-muted small mb-0">Period: <strong>@Model.DateFrom.ToString("dd MMM yyyy")</strong> to <strong>@Model.DateTo.ToString("dd MMM yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="ExportExcel" asp-route-reportType="TeacherAttendance" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
        <a asp-action="ExportCsv" asp-route-reportType="TeacherAttendance" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-file-earmark-text"></i> CSV
        </a>
        <button onclick="window.print()" class="btn btn-light border btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>

<!-- Print Header -->
<div class="print-header">
    <h2>Faculty Attendance Summary Report</h2>
    <p>Date Range: @Model.DateFrom.ToString("dd MMM yyyy") to @Model.DateTo.ToString("dd MMM yyyy")</p>
</div>

<!-- Filter Box -->
<div class="card card-custom p-3 mb-4 no-print">
    <form method="get" asp-action="TeacherAttendance" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Faculty Member</label>
            <select asp-for="TeacherId" asp-items="Model.Teachers" class="form-select form-select-sm">
                <option value="">-- All Faculty --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">From Date</label>
            <input asp-for="DateFrom" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">To Date</label>
            <input asp-for="DateTo" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Generate</button>
            <a asp-action="TeacherAttendance" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Report Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Emp. ID</th>
                    <th>Faculty Name</th>
                    <th>Designation</th>
                    <th>Subject</th>
                    <th>Total Days</th>
                    <th>Present</th>
                    <th>Absent</th>
                    <th>Leave</th>
                    <th>Attendance %</th>
                </tr>
            </thead>
            <tbody>
                @if (reportData.Any())
                {
                    @foreach (var r in reportData)
                    {
                        <tr>
                            <td><span class="badge bg-light text-secondary border">@r.EmployeeId</span></td>
                            <td class="fw-semibold">@r.TeacherName</td>
                            <td>@r.Designation</td>
                            <td>@(r.Subject ?? "General")</td>
                            <td>@r.TotalWorkingDays</td>
                            <td><span class="badge bg-success-subtle text-success">@r.PresentDays</span></td>
                            <td><span class="badge bg-danger-subtle text-danger">@r.AbsentDays</span></td>
                            <td>@r.LeaveDays</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 50px;">
                                        <div class="progress-bar @(r.AttendancePercentage >= 85 ? "bg-success" : "bg-warning")" style="width: @r.AttendancePercentage%"></div>
                                    </div>
                                    <span class="fw-bold small">@r.AttendancePercentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-5 text-muted">No attendance data found for the selected faculty.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="print-footer-signatures">
    <div>
        ____________________________<br />
        HR / Staff In-charge
    </div>
    <div>
        ____________________________<br />
        Principal / Director
    </div>
</div>
