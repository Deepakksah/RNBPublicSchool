@model SchoolManagement.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Class Attendance Report";
    var reportData = ViewBag.ReportData as List<SchoolManagement.ViewModels.ClassAttendanceReportItem> ?? new();
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom no-print">
    <div>
        <h4 class="fw-bold mb-1">Class Attendance Report</h4>
        <p class="text-muted small mb-0">Period: <strong>@Model.DateFrom.ToString("dd MMM yyyy")</strong> to <strong>@Model.DateTo.ToString("dd MMM yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="ExportExcel" asp-route-reportType="ClassAttendance" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
        <a asp-action="ExportCsv" asp-route-reportType="ClassAttendance" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-file-earmark-text"></i> CSV
        </a>
        <button onclick="window.print()" class="btn btn-light border btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>

<!-- Print Header -->
<div class="print-header">
    <h2>Class-wise Attendance Comparative Report</h2>
    <p>Date Range: @Model.DateFrom.ToString("dd MMM yyyy") to @Model.DateTo.ToString("dd MMM yyyy")</p>
</div>

<!-- Filter Box -->
<div class="card card-custom p-3 mb-4 no-print">
    <form method="get" asp-action="ClassAttendance" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Class</label>
            <select asp-for="ClassId" asp-items="Model.Classes" class="form-select form-select-sm" id="filterClassSelect">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Section</label>
            <select asp-for="SectionId" asp-items="Model.Sections" class="form-select form-select-sm" id="filterSectionSelect">
                <option value="">-- All Sections --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">From Date</label>
            <input asp-for="DateFrom" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">To Date</label>
            <input asp-for="DateTo" class="form-control form-control-sm" type="date" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Generate</button>
            <a asp-action="ClassAttendance" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Report Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Class Name</th>
                    <th>Section</th>
                    <th>Class Teacher</th>
                    <th>Total Students</th>
                    <th>Present Entries</th>
                    <th>Absent Entries</th>
                    <th>Leave Entries</th>
                    <th>Average Rate %</th>
                </tr>
            </thead>
            <tbody>
                @if (reportData.Any())
                {
                    @foreach (var r in reportData)
                    {
                        <tr>
                            <td class="fw-bold">@r.ClassName</td>
                            <td>Section @r.SectionName</td>
                            <td>@(r.ClassTeacherName ?? "<em class='text-muted'>None</em>")</td>
                            <td>@r.TotalStudents</td>
                            <td><span class="badge bg-success-subtle text-success">@r.TotalPresent</span></td>
                            <td><span class="badge bg-danger-subtle text-danger">@r.TotalAbsent</span></td>
                            <td>@r.TotalLeave</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar bg-primary" style="width: @r.AverageAttendanceRate%"></div>
                                    </div>
                                    <span class="fw-bold small">@r.AverageAttendanceRate%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted">No class attendance records found for this period.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="print-footer-signatures">
    <div>
        ____________________________<br />
        Academic Supervisor
    </div>
    <div>
        ____________________________<br />
        Principal / Dean
    </div>
</div>
