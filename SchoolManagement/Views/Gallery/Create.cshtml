@model SchoolManagement.ViewModels.GalleryUploadViewModel
@{
    ViewData["Title"] = "Upload Gallery Photos";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Upload Campus Photos</h4>
        <p class="text-muted small mb-0">Select multiple JPG, PNG, or WEBP photos</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Gallery</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Science Fair 2026 / Smart Classroom" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold small"></label>
                    <select asp-for="Category" asp-items="Model.Categories" class="form-select" required></select>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFiles" class="form-label fw-semibold small"></label>
                    <input asp-for="ImageFiles" type="file" multiple class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                    <span asp-validation-for="ImageFiles" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="SetAsCover" class="form-check-input" />
                    <label asp-for="SetAsCover" class="form-check-label small fw-semibold">Set as featured cover photo</label>
                </div>

                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Start Upload
                </button>
            </form>
        </div>
    </div>
</div>
