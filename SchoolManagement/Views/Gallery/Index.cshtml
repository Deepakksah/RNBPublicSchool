@model SchoolManagement.ViewModels.GalleryViewModel
@{
    ViewData["Title"] = "School Photo Gallery";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Campus Image Gallery</h4>
        <p class="text-muted small mb-0">Showcase campus life, laboratories, sports, and cultural events</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-cloud-upload-fill"></i>
            <span>Upload Photos</span>
        </a>
    </div>
</div>

<!-- Category Tabs -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedCategory) ? "btn-primary" : "btn-light border")">
        All Photos
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index" asp-route-category="@cat" class="btn btn-sm @(Model.SelectedCategory == cat ? "btn-primary" : "btn-light border")">
            @cat
        </a>
    }
</div>

<!-- Photo Grid -->
<div class="row g-4">
    @if (Model.Images.Any())
    {
        @foreach (var img in Model.Images)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card card-custom h-100 overflow-hidden">
                    <div style="height: 180px; overflow: hidden; position: relative;">
                        <img src="@img.ImagePath" alt="@img.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                        @if (img.IsCoverImage)
                        {
                            <span class="badge bg-primary position-absolute top-0 start-0 m-2"><i class="bi bi-star-fill me-1"></i>Cover</span>
                        }
                    </div>
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-1 text-truncate">@img.Title</h6>
                        <span class="badge bg-light text-secondary border small mb-2">@img.Category</span>
                        @if (!string.IsNullOrEmpty(img.Description))
                        {
                            <p class="text-muted small mb-0 text-truncate">@img.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-white p-2 d-flex justify-content-between align-items-center border-top">
                        <small class="text-muted" style="font-size: 0.72rem;">@img.UploadDate.ToString("dd MMM yyyy")</small>
                        <form asp-action="Delete" asp-route-id="@img.Id" method="post" onsubmit="return confirm('Delete this image?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete Image">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-images fs-1 d-block mb-2"></i>
            No images uploaded in this category. Click "Upload Photos" above.
        </div>
    }
</div>
