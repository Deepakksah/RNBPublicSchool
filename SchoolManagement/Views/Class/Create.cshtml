@model SchoolManagement.ViewModels.ClassCreateEditViewModel
@{
    ViewData["Title"] = "Add New Class";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Add Academic Class</h4>
        <p class="text-muted small mb-0">Create grade/standard level</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Class 1, Class 10, Nursery" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" min="1" required />
                    <small class="text-muted">Determines ordering in reports and dropdowns</small>
                </div>

                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Create Class
                </button>
            </form>
        </div>
    </div>
</div>
