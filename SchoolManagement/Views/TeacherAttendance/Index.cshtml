@model SchoolManagement.ViewModels.TeacherAttendanceSheetViewModel
@{
    ViewData["Title"] = "Teacher Attendance Sheet";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Faculty & Staff Attendance Registry</h4>
        <p class="text-muted small mb-0">Record and manage faculty attendance for <strong>@Model.AttendanceDate.ToString("dd MMMM yyyy")</strong></p>
    </div>
</div>

<!-- Date & Academic Year Filter -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Academic Year</label>
            <select asp-for="AcademicYearId" asp-items="Model.AcademicYears" class="form-select form-select-sm" required></select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Attendance Date</label>
            <input asp-for="AttendanceDate" class="form-control form-control-sm" type="date" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Load Sheet</button>
        </div>
    </form>
</div>

@if (Model.Teachers != null && Model.Teachers.Any())
{
    <form asp-action="Save" method="post" id="teacherAttendanceForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SchoolId" />
        <input type="hidden" asp-for="AcademicYearId" />
        <input type="hidden" asp-for="AttendanceDate" />

        <!-- Quick Actions & Status Info -->
        <div class="card card-custom p-3 mb-3 bg-light border">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="small fw-bold text-muted me-1">Quick Fill:</span>
                    <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="markAllStudents('1')">
                        <i class="bi bi-check-all me-1"></i> Mark All Present
                    </button>
                    <button type="button" class="btn btn-sm btn-danger fw-semibold" onclick="markAllStudents('2')">
                        <i class="bi bi-x-octagon me-1"></i> Mark All Absent
                    </button>
                    @if (Model.IsAlreadyMarked)
                    {
                        <span class="badge bg-info-subtle text-info border ms-2">
                            <i class="bi bi-info-circle me-1"></i> Attendance already saved for this date
                        </span>
                    }
                </div>

                <div class="d-flex gap-3 small">
                    <div>Present: <strong class="text-success" id="countPresent">0</strong></div>
                    <div>Absent: <strong class="text-danger" id="countAbsent">0</strong></div>
                    <div>Leave: <strong class="text-warning" id="countLeave">0</strong></div>
                    <div>Late: <strong class="text-primary" id="countLate">0</strong></div>
                </div>
            </div>
        </div>

        <!-- Teachers Table -->
        <div class="card card-custom mb-4">
            <div class="table-responsive">
                <table class="table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Faculty Name</th>
                            <th>Designation</th>
                            <th class="text-center" style="width: 320px;">Attendance Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Teachers.Count; i++)
                        {
                            var t = Model.Teachers[i];
                            <tr>
                                <td>
                                    <input type="hidden" name="Teachers[@i].TeacherId" value="@t.TeacherId" />
                                    <input type="hidden" name="Teachers[@i].EmployeeId" value="@t.EmployeeId" />
                                    <input type="hidden" name="Teachers[@i].TeacherName" value="@t.TeacherName" />
                                    <input type="hidden" name="Teachers[@i].Designation" value="@t.Designation" />
                                    <span class="badge bg-light text-secondary border">@t.EmployeeId</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-img avatar-sm bg-light border d-flex align-items-center justify-content-center overflow-hidden">
                                            @if (!string.IsNullOrEmpty(t.Photo))
                                            {
                                                <img src="@t.Photo" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-primary small">@(t.TeacherName.Substring(0, 1).ToUpper())</span>
                                            }
                                        </div>
                                        <div class="fw-bold">@t.TeacherName</div>
                                    </div>
                                </td>
                                <td>@t.Designation</td>
                                <td>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check attendance-radio" name="Teachers[@i].Status" id="t_pres_@i" value="1" @(t.Status == SchoolManagement.Models.AttendanceStatus.Present ? "checked" : "") autocomplete="off">
                                        <label class="btn btn-outline-success btn-sm" for="t_pres_@i">Present</label>

                                        <input type="radio" class="btn-check attendance-radio" name="Teachers[@i].Status" id="t_abs_@i" value="2" @(t.Status == SchoolManagement.Models.AttendanceStatus.Absent ? "checked" : "") autocomplete="off">
                                        <label class="btn btn-outline-danger btn-sm" for="t_abs_@i">Absent</label>

                                        <input type="radio" class="btn-check attendance-radio" name="Teachers[@i].Status" id="t_leave_@i" value="3" @(t.Status == SchoolManagement.Models.AttendanceStatus.Leave ? "checked" : "") autocomplete="off">
                                        <label class="btn btn-outline-warning btn-sm" for="t_leave_@i">Leave</label>

                                        <input type="radio" class="btn-check attendance-radio" name="Teachers[@i].Status" id="t_late_@i" value="4" @(t.Status == SchoolManagement.Models.AttendanceStatus.Late ? "checked" : "") autocomplete="off">
                                        <label class="btn btn-outline-primary btn-sm" for="t_late_@i">Late</label>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" name="Teachers[@i].Remarks" value="@t.Remarks" class="form-control form-control-sm" placeholder="Optional remark..." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white p-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Total Faculty: <strong>@Model.Teachers.Count</strong></span>
                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-save me-1"></i> Save Faculty Attendance
                </button>
            </div>
        </div>
    </form>
}
else
{
    <div class="card card-custom p-5 text-center text-muted">
        <i class="bi bi-person-badge fs-1 text-secondary mb-2"></i>
        <h5>No Faculty Members Registered</h5>
        <p class="small mb-3">Add faculty members to begin recording staff attendance.</p>
        <a asp-controller="Teacher" asp-action="Create" class="btn btn-primary btn-sm mx-auto">Register Faculty</a>
    </div>
}
