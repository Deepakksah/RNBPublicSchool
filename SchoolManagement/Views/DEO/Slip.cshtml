@model SchoolManagement.Models.Student
@{
    ViewData["Title"] = $"Admission Slip — {Model.AdmissionNumber}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admission Slip - @Model.AdmissionNumber - @Model.Name</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            padding: 2rem 1rem;
        }

        .slip-container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
        }

        .slip-header {
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .school-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            color: #1e3a8a;
            margin-bottom: 0.2rem;
            font-size: 1.4rem;
        }

        .table-slip th {
            width: 25%;
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            border: 1px solid #e2e8f0;
        }

        .table-slip td {
            width: 25%;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 0.5rem 0.75rem;
            border: 1px solid #e2e8f0;
        }

        @@media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }
            .slip-container {
                box-shadow: none;
                border: 1px solid #000;
                padding: 1.5rem;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-center mb-3 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm">
            🖨️ Print Official Admission Slip
        </button>
        <a href="/DEO/Index" class="btn btn-outline-secondary btn-sm ms-2">Back to DEO Desk</a>
    </div>

    <div class="slip-container">
        <!-- HEADER -->
        <div class="slip-header">
            <div class="d-flex align-items-center gap-3">
                <img src="/uploads/schools/rnb-logo.jpg" alt="Logo" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" class="border" onerror="this.src='/images/rnb-logo.jpg'" />
                <div>
                    <h2 class="school-title">@(Model.School?.Name ?? "R N B PUBLIC SCHOOL, PIRO")</h2>
                    <div class="small text-muted">8CM3+PH4, Piro, Bhojpur, Bihar 802207 • Phone: 094708 35418 / 09661160546</div>
                    <div class="fw-bold text-success small mt-1">OFFICIAL ADMISSION ACKNOWLEDGEMENT RECEIPT (2026-27)</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <div class="border rounded p-1 bg-light text-center" style="width: 80px; height: 95px;">
                    <img src="@Model.Photo" alt="Photo" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" />
                </div>
            }
        </div>

        <!-- ADMISSION DETAILS TABLE -->
        <table class="table table-slip mb-4">
            <tbody>
                <tr>
                    <th>Admission No</th>
                    <td class="fw-bold text-primary">@Model.AdmissionNumber</td>
                    <th>Admission Date</th>
                    <td>@Model.AdmissionDate.ToString("dd MMMM yyyy")</td>
                </tr>
                <tr>
                    <th>Student Name</th>
                    <td class="fw-bold fs-6" colspan="3">@Model.Name</td>
                </tr>
                <tr>
                    <th>Enrolled Class</th>
                    <td class="fw-bold">@Model.Class?.Name</td>
                    <th>Section & Roll No</th>
                    <td class="fw-bold">@Model.Section?.Name (Roll No: @Model.RollNumber)</td>
                </tr>
                <tr>
                    <th>Date of Birth</th>
                    <td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    <th>Gender & Blood</th>
                    <td>@Model.Gender (@(Model.BloodGroup ?? "N/A"))</td>
                </tr>
                <tr>
                    <th>Father's Name</th>
                    <td class="fw-semibold">@Model.FatherName</td>
                    <th>Father's Mobile</th>
                    <td class="fw-bold">@Model.FatherMobile</td>
                </tr>
                <tr>
                    <th>Mother's Name</th>
                    <td>@Model.MotherName</td>
                    <th>Mother's Mobile</th>
                    <td>@(string.IsNullOrEmpty(Model.MotherMobile) ? "—" : Model.MotherMobile)</td>
                </tr>
                <tr>
                    <th>Location / Address</th>
                    <td colspan="3">@Model.Address, @Model.City, @Model.State - @Model.PinCode</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td><span class="badge bg-success">@Model.Status</span></td>
                    <th>Academic Session</th>
                    <td>@(Model.AcademicYear?.Name ?? "2026-2027")</td>
                </tr>
            </tbody>
        </table>

        <!-- TERMS & SIGNATURES -->
        <div class="p-3 bg-light rounded border mb-4">
            <small class="text-muted d-block" style="font-size: 0.76rem; line-height: 1.5;">
                * This slip serves as official proof of student enrollment in R N B Public School, Piro for Session 2026-27. Please preserve this admission number for all future fee payments, exams, and ERP logins.
            </small>
        </div>

        <div class="d-flex justify-content-between text-center pt-4" style="margin-top: 2rem;">
            <div>
                ____________________________<br />
                <strong class="small">DEO / Data Entry Operator</strong>
            </div>
            <div>
                ____________________________<br />
                <strong class="small">Parent / Guardian Signature</strong>
            </div>
            <div>
                ____________________________<br />
                <strong class="small">Principal / Head Office Seal</strong>
            </div>
        </div>
    </div>
</body>
</html>
