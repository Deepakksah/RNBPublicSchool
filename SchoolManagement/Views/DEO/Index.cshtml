@model SchoolManagement.ViewModels.DEOConsoleViewModel
@{
    ViewData["Title"] = "DEO Admission Desk — Operator Portal";
}

<!-- Header & Fast Actions -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">DEO Student Admission Desk</h4>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Data Entry Console</span>
        </div>
        <p class="text-muted small mb-0">Fast New Student Registrations, Records Management & Real-Time Sync</p>
    </div>
    <div class="mt-2 mt-md-0 d-flex gap-2">
        <a asp-action="Admission" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm px-3 fw-semibold">
            <i class="bi bi-person-plus-fill fs-6"></i>
            <span>+ New Student Admission</span>
        </a>
    </div>
</div>

<!-- Operator Metric Cards (Unified Rich Theme) -->
<div class="row g-2 mb-2">
    <div class="col-sm-4">
        <div class="kpi-card kpi-blue py-1.5 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">TOTAL ADMITTED STUDENTS</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.TotalStudents.ToString("N0")</div>
                <small class="text-white-50" style="font-size: 0.68rem;">Registered in institution</small>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi-card kpi-green py-1.5 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">ADMISSIONS TODAY</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.TodayAdmissionsCount</div>
                <small class="text-white fw-semibold" style="font-size: 0.68rem;">Enrolled today</small>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="kpi-card kpi-purple py-1.5 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">ADMISSIONS THIS MONTH</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.ThisMonthAdmissionsCount</div>
                <small class="text-white-50" style="font-size: 0.68rem;">@DateTime.Today.ToString("MMMM yyyy")</small>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card card-custom p-2.5 mb-2">
    <form method="get" asp-action="Index" id="deoFilterForm" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Class</label>
            <select name="classId" asp-items="Model.Classes" class="form-select form-select-sm" id="deoFilterClass">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Section / Classroom</label>
            <select name="sectionId" asp-items="Model.Sections" class="form-select form-select-sm" id="deoFilterSection">
                <option value="">-- All Sections --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Live Student Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                <input type="text" name="search" id="deoSearchInput" value="@Model.SearchTerm" class="form-control" placeholder="Type student name, admission no, roll, mobile, father name..." autocomplete="off" />
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Search"><i class="bi bi-x"></i></a>
                }
            </div>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1 fw-semibold">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- DEO High-Density Student Table -->
<div class="card card-custom" id="deoTableCard">
    <div class="table-responsive">
        <table class="table-custom mb-0" id="deoStudentTable">
            <thead>
                <tr>
                    <th>Adm. No</th>
                    <th>Student Name</th>
                    <th>Class & Sec</th>
                    <th>Roll No</th>
                    <th>Father Name</th>
                    <th>Father Mobile</th>
                    <th>Location / Address</th>
                    <th>Adm. Date</th>
                    <th class="text-end">DEO Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentAdmissions.Any())
                {
                    @foreach (var s in Model.RecentAdmissions)
                    {
                        <tr class="deo-student-row">
                            <td><span class="badge bg-light text-secondary border fw-bold">@s.AdmissionNumber</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-img avatar-sm bg-light d-flex align-items-center justify-content-center border overflow-hidden">
                                        @if (!string.IsNullOrEmpty(s.Photo))
                                        {
                                            <img src="@s.Photo" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-primary small">@(s.Name.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark">@s.Name</span>
                                        <div class="text-muted" style="font-size: 0.72rem;">@s.Gender, DOB: @s.DateOfBirth.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary">@s.Class.Name - @s.Section.Name</span></td>
                            <td class="fw-bold text-center">@s.RollNumber</td>
                            <td>@s.FatherName</td>
                            <td>
                                <a href="tel:@s.FatherMobile" class="text-decoration-none text-dark fw-semibold">
                                    <i class="bi bi-telephone text-muted me-1"></i>@s.FatherMobile
                                </a>
                            </td>
                            <td><small class="text-muted">@s.Address, @s.City</small></td>
                            <td><small class="text-muted">@s.AdmissionDate.ToString("dd MMM yyyy")</small></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Slip" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info py-0 px-1.5" title="Print Official Admission Slip" target="_blank">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <a asp-controller="Student" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary py-0 px-1.5" title="Edit Student Record">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-controller="Student" asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Are you sure you want to remove student @s.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1.5" title="Delete Student Record">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            No students found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 px-3 border-top">
            <small class="text-muted">
                Showing <strong>@(((Model.PageIndex - 1) * 20) + 1)</strong> to <strong>@(Math.Min(Model.PageIndex * 20, Model.TotalStudents))</strong> of <strong>@Model.TotalStudents</strong> records
            </small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">&laquo;</a>
                </li>
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">Prev</a>
                </li>
                @{
                    int startPage = Math.Max(1, Model.PageIndex - 2);
                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">Next</a>
                </li>
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Real-Time Instant Live Search as you type
            $('#deoSearchInput').on('input', function () {
                var query = $(this).val().toLowerCase().trim();
                var $rows = $('#deoStudentTable tbody tr.deo-student-row');
                var matches = 0;

                $rows.each(function () {
                    var rowText = $(this).text().toLowerCase();
                    if (query === '' || rowText.indexOf(query) !== -1) {
                        $(this).show();
                        matches++;
                    } else {
                        $(this).hide();
                    }
                });

                var $empty = $('#deoNoMatchRow');
                if (matches === 0 && query !== '') {
                    if ($empty.length === 0) {
                        $('#deoStudentTable tbody').append('<tr id="deoNoMatchRow"><td colspan="9" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i> No students matching "<strong>' + query + '</strong>" on this page</td></tr>');
                    } else {
                        $empty.show().find('strong').text(query);
                    }
                } else if ($empty.length > 0) {
                    $empty.hide();
                }
            });

            // Dynamic Sections on Class Change
            $('#deoFilterClass').on('change', function () {
                var classId = $(this).val();
                var $sec = $('#deoFilterSection');
                $sec.empty().append('<option value="">-- All Sections --</option>');
                if (classId) {
                    $.getJSON('/DEO/GetSections?classId=' + classId, function (data) {
                        $.each(data, function (i, item) {
                            $sec.append($('<option>', { value: item.id, text: item.name }));
                        });
                    });
                }
            });
        });
    </script>
}
