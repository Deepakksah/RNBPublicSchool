@model SchoolManagement.ViewModels.DEOAdmissionViewModel
@{
    ViewData["Title"] = "New Student Admission — DEO Desk";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-light border text-muted"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">New Student Admission Data Entry</h4>
            <span class="badge bg-success-subtle text-success">Session 2026-27</span>
        </div>
        <p class="text-muted small mb-0 ms-md-4 ps-md-2">Fill all student, parent, and classroom parameters. Data syncs instantly across all school databases.</p>
    </div>
</div>

<form asp-action="Admission" method="post" enctype="multipart/form-data" id="admissionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SchoolId" />

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-2">
            <i class="bi bi-exclamation-circle-fill"></i>
            <div>@Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })</div>
        </div>
    }

    <div class="row g-3 mb-4">
        <!-- 1. ACADEMIC & CLASSROOM ASSIGNMENT -->
        <div class="col-12">
            <div class="card card-custom p-3 border-start border-4 border-primary">
                <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>1. Academic Enrollment & Classroom</span>
                </h6>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label asp-for="AcademicYearId" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="AcademicYearId" asp-items="Model.AcademicYears" class="form-select form-select-sm" required></select>
                        <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ClassId" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="ClassId" asp-items="Model.Classes" class="form-select form-select-sm" id="classSelect" required></select>
                        <span asp-validation-for="ClassId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="SectionId" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="SectionId" asp-items="Model.Sections" class="form-select form-select-sm" id="sectionSelect" required></select>
                        <span asp-validation-for="SectionId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="AdmissionNumber" class="form-label small fw-semibold text-muted mb-0"></label>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">Auto</span>
                        </div>
                        <input asp-for="AdmissionNumber" class="form-control form-control-sm fw-bold text-primary" required />
                        <span asp-validation-for="AdmissionNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="RollNumber" class="form-label small fw-semibold text-muted mb-0"></label>
                            <span class="badge bg-success-subtle text-success" id="rollBadge" style="font-size: 0.65rem;">Auto-Allocated</span>
                        </div>
                        <input asp-for="RollNumber" class="form-control form-control-sm fw-bold" id="rollInput" type="number" min="1" max="200" required />
                        <span asp-validation-for="RollNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. STUDENT PERSONAL DETAILS & PHOTO -->
        <div class="col-md-7">
            <div class="card card-custom p-3 h-100 border-start border-4 border-info">
                <h6 class="fw-bold text-info mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-person-fill"></i>
                    <span>2. Student Bio & Personal Details</span>
                </h6>
                <div class="row g-2">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Name" class="form-control form-control-sm fw-bold" placeholder="e.g. Aarav Kumar Sharma" required autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="DateOfBirth" class="form-control form-control-sm" type="date" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="Gender" class="form-select form-select-sm" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BloodGroup" class="form-label small fw-semibold text-muted"></label>
                        <select asp-for="BloodGroup" class="form-select form-select-sm">
                            <option value="O+">O+</option>
                            <option value="A+">A+</option>
                            <option value="B+">B+</option>
                            <option value="AB+">AB+</option>
                            <option value="O-">O-</option>
                            <option value="A-">A-</option>
                            <option value="B-">B-</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdmissionDate" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="AdmissionDate" class="form-control form-control-sm" type="date" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Email" class="form-control form-control-sm" placeholder="student/parent email" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PHOTO UPLOAD WITH LIVE PREVIEW -->
        <div class="col-md-5">
            <div class="card card-custom p-3 h-100 text-center d-flex flex-column justify-content-center">
                <h6 class="fw-bold text-muted mb-2">Student Photo</h6>
                <div class="avatar-preview-box mx-auto mb-2 border rounded-3 bg-light d-flex align-items-center justify-content-center overflow-hidden" style="width: 100px; height: 110px;">
                    <img id="photoPreview" src="/images/default-avatar.png" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                    <i id="photoPlaceholder" class="bi bi-person-bounding-box fs-1 text-muted"></i>
                </div>
                <input asp-for="PhotoFile" class="form-control form-control-sm" type="file" accept="image/*" id="photoInput" />
                <small class="text-muted mt-1" style="font-size: 0.72rem;">JPG, PNG, WEBP (Max 2MB)</small>
            </div>
        </div>

        <!-- 3. PARENT & GUARDIAN CONTACT DETAILS -->
        <div class="col-md-6">
            <div class="card card-custom p-3 h-100 border-start border-4 border-success">
                <h6 class="fw-bold text-success mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill"></i>
                    <span>3. Parents & Guardian Details</span>
                </h6>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label asp-for="FatherName" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="FatherName" class="form-control form-control-sm" placeholder="Father's full name" required />
                        <span asp-validation-for="FatherName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FatherMobile" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="FatherMobile" class="form-control form-control-sm" placeholder="10-digit mobile" required />
                        <span asp-validation-for="FatherMobile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MotherName" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="MotherName" class="form-control form-control-sm" placeholder="Mother's full name" required />
                        <span asp-validation-for="MotherName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MotherMobile" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="MotherMobile" class="form-control form-control-sm" placeholder="Mother's mobile (optional)" />
                    </div>
                    <div class="col-12">
                        <label asp-for="GuardianName" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="GuardianName" class="form-control form-control-sm" placeholder="Local guardian name if different" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. RESIDENTIAL LOCATION & ADDRESS -->
        <div class="col-md-6">
            <div class="card card-custom p-3 h-100 border-start border-4 border-warning">
                <h6 class="fw-bold text-warning mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>4. Residential Address & Location</span>
                </h6>
                <div class="row g-2">
                    <div class="col-12">
                        <label asp-for="Address" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Address" class="form-control form-control-sm" placeholder="Village / Ward / Street Address" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="City" class="form-control form-control-sm" value="Piro" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="State" class="form-control form-control-sm" value="Bihar" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PinCode" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="PinCode" class="form-control form-control-sm" value="802207" required />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BUTTON BAR -->
    <div class="card card-custom p-3 bg-light border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 sticky-bottom shadow-sm">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" name="submitAction" value="Save" class="btn btn-primary btn-sm px-3 fw-bold">
                <i class="bi bi-check2-circle me-1"></i> Save & Return
            </button>
            <button type="submit" name="submitAction" value="SaveAndNew" class="btn btn-success btn-sm px-3 fw-bold">
                <i class="bi bi-person-plus-fill me-1"></i> Save & Admit Next (+)
            </button>
            <button type="submit" name="submitAction" value="SaveAndPrint" class="btn btn-dark btn-sm px-3 fw-bold">
                <i class="bi bi-printer me-1"></i> Save & Print Slip
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Photo live preview
        document.getElementById('photoInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const preview = document.getElementById('photoPreview');
                    preview.src = event.target.result;
                    preview.style.display = 'block';
                    document.getElementById('photoPlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        // Dynamic Section and Auto-Roll Loader
        $('#classSelect').on('change', function () {
            var classId = $(this).val();
            var $sec = $('#sectionSelect');
            $sec.empty();
            if (classId) {
                $.getJSON('/DEO/GetSections?classId=' + classId, function (data) {
                    $.each(data, function (i, item) {
                        $sec.append($('<option>', { value: item.id, text: item.name }));
                    });
                    $sec.trigger('change');
                });
            }
        });

        $('#sectionSelect').on('change', function () {
            var sectionId = $(this).val();
            if (sectionId) {
                $.getJSON('/DEO/GetNextRoll?sectionId=' + sectionId, function (res) {
                    if (res && res.nextRoll) {
                        $('#rollInput').val(res.nextRoll);
                    }
                });
            }
        });
    </script>
}
