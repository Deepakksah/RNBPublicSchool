@model SchoolManagement.ViewModels.UserCreateEditViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Create User Account</h4>
        <p class="text-muted small mb-0">Assign credentials, tenant school, and role permissions</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small"></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control" placeholder="john@school.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold small"></label>
                    <input asp-for="UserName" class="form-control" placeholder="e.g. jdoe" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small"></label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold small">Assign Role</label>
                    <select asp-for="Role" asp-items="Model.Roles" class="form-select" required></select>
                </div>

                <div class="mb-4">
                    <label asp-for="SchoolId" class="form-label fw-semibold small">Assign School (Leave empty for Super Admin)</label>
                    <select asp-for="SchoolId" asp-items="Model.Schools" class="form-select">
                        <option value="">-- Global / No School --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-person-check-fill me-1"></i> Create User
                </button>
            </form>
        </div>
    </div>
</div>
