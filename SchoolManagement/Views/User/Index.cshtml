@model SchoolManagement.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Users & Role Access Management</h4>
        <p class="text-muted small mb-0">Manage system administrators, teachers, staff, and role-based permissions</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span>Create New User</span>
        </a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>User / Full Name</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Assigned School</th>
                    <th>Assigned Roles</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-img avatar-sm bg-primary text-white d-flex align-items-center justify-content-center fw-bold">
                                    @(u.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <span class="fw-bold text-dark">@u.FullName</span>
                            </div>
                        </td>
                        <td><code>@u.UserName</code></td>
                        <td>@u.Email</td>
                        <td>@(u.SchoolName ?? "<span class='badge bg-light text-dark border'>Global Super Admin</span>")</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge bg-primary-subtle text-primary me-1">@r</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Disabled</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") py-0 px-2">
                                    @(u.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
