@model SchoolManagement.ViewModels.SchoolDashboardViewModel
@{
    ViewData["Title"] = $"{Model.School.Name} - Dashboard";
}

<!-- KPI Cards -->
<div class="row g-2 mb-2">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card kpi-blue">
            <div>
                <div class="kpi-title">Total Students</div>
                <div class="kpi-value">@Model.TotalStudents</div>
                <small class="text-white-50" style="font-size: 0.72rem;">Enrolled & active</small>
            </div>
            <div class="kpi-icon-wrapper">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card kpi-green">
            <div>
                <div class="kpi-title">Students Present Today</div>
                <div class="kpi-value">@Model.PresentStudents</div>
                <small class="text-white fw-semibold" style="font-size: 0.72rem;">@Model.StudentAttendancePercentage% Attendance</small>
            </div>
            <div class="kpi-icon-wrapper">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card kpi-red">
            <div>
                <div class="kpi-title">Students Absent Today</div>
                <div class="kpi-value">@Model.AbsentStudents</div>
                <small class="text-white-50" style="font-size: 0.72rem;">@Model.LeaveStudents on leave</small>
            </div>
            <div class="kpi-icon-wrapper">
                <i class="bi bi-x-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card kpi-purple">
            <div>
                <div class="kpi-title">Faculty Present</div>
                <div class="kpi-value">@Model.PresentTeachers / @Model.TotalTeachers</div>
                <small class="text-white-50" style="font-size: 0.72rem;">@Model.TeacherAttendancePercentage% Faculty Present</small>
            </div>
            <div class="kpi-icon-wrapper">
                <i class="bi bi-person-badge"></i>
            </div>
        </div>
    </div>
</div>

<!-- Compact 7-Day Trend Chart & Today Ratio -->
<div class="row g-2 mb-2">
    <div class="col-lg-8">
        <div class="card card-custom h-100">
            <div class="card-header-custom py-1 px-3">
                <span class="fw-bold small mb-0"><i class="bi bi-graph-up text-primary me-1"></i>Attendance Trend (Last 7 Days)</span>
                <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">Dynamic Trend</span>
            </div>
            <div class="card-body p-2">
                <div style="height: 130px;">
                    <canvas id="dailyTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-custom h-100">
            <div class="card-header-custom py-1 px-3">
                <span class="fw-bold small mb-0"><i class="bi bi-pie-chart text-success me-1"></i>Today's Attendance</span>
                <small class="text-muted" style="font-size: 0.72rem;">@DateTime.Today.ToString("dd MMM yyyy")</small>
            </div>
            <div class="card-body p-2 d-flex align-items-center justify-content-around">
                <div style="width: 105px; height: 105px; flex-shrink: 0;">
                    <canvas id="todayRatioChart"></canvas>
                </div>
                <div class="d-flex flex-column gap-1 text-center small">
                    <div class="bg-success-subtle px-2 py-1 rounded">
                        <span class="text-muted d-block" style="font-size: 0.7rem;">Present</span>
                        <strong class="text-success fs-6">@Model.PresentStudents</strong>
                    </div>
                    <div class="bg-danger-subtle px-2 py-1 rounded">
                        <span class="text-muted d-block" style="font-size: 0.7rem;">Absent</span>
                        <strong class="text-danger fs-6">@Model.AbsentStudents</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Class-wise Attendance & Quick Notices -->
<div class="row g-2">
    <!-- Class Breakdown -->
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header-custom py-1 px-3">
                <span class="fw-bold small mb-0"><i class="bi bi-diagram-3 me-1 text-primary"></i>Today's Class Attendance Breakdown</span>
                <a asp-controller="Attendance" asp-action="DailyReport" class="small text-decoration-none">Full Daily Report &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Class & Section</th>
                            <th>Class Teacher</th>
                            <th>Total</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Attendance %</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ClassAttendanceSummaries.Any())
                        {
                            @foreach (var c in Model.ClassAttendanceSummaries)
                            {
                                <tr>
                                    <td class="fw-bold">@c.ClassName - Section @c.SectionName</td>
                                    <td>@(c.ClassTeacherName ?? "<em class='text-muted'>Not Assigned</em>")</td>
                                    <td>@c.TotalStudents</td>
                                    <td><span class="badge bg-success-subtle text-success">@c.Present</span></td>
                                    <td><span class="badge bg-danger-subtle text-danger">@c.Absent</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 5px; width: 45px;">
                                                <div class="progress-bar bg-primary" style="width: @c.AttendancePercentage%"></div>
                                            </div>
                                            <small class="fw-semibold">@c.AttendancePercentage%</small>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Attendance" asp-action="StudentAttendance" asp-route-classId="@c.ClassId" asp-route-sectionId="@c.SectionId" class="btn btn-sm btn-outline-primary py-0 px-2" title="Mark Attendance">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-3 text-muted">No classes active for this school.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Notices & Holidays -->
    <div class="col-lg-4">
        <!-- Notices & Inquiries -->
        <div class="card card-custom mb-2">
            <div class="card-header-custom py-1 px-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold small mb-0"><i class="bi bi-megaphone me-1 text-warning"></i>Notices & Online Inquiries</span>
                <a asp-controller="Notification" asp-action="Index" class="small text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush small">
                    @if (Model.RecentNotifications.Any())
                    {
                        @foreach (var n in Model.RecentNotifications)
                        {
                            var isInquiry = n.Title.Contains("Inquiry") || n.Title.Contains("Admission");
                            <div class="list-group-item px-3 py-1.5 @(isInquiry ? "bg-warning-subtle bg-opacity-25" : "")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="fw-semibold text-truncate" style="max-width: 220px;" title="@n.Title">
                                        @if (isInquiry)
                                        {
                                            <span class="badge bg-warning text-dark me-1" style="font-size: 0.65rem;">NEW</span>
                                        }
                                        @n.Title
                                    </div>
                                    <small class="text-muted" style="font-size: 0.7rem;">@n.PublishDate.ToString("dd MMM")</small>
                                </div>
                                <small class="text-muted text-truncate d-block" style="font-size: 0.72rem; line-height: 1.3;" title="@n.Description">
                                    @n.Description
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-2 text-center text-muted small">No recent notices or inquiries.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Holidays for Current Month -->
        <div class="card card-custom">
            <div class="card-header-custom py-1 px-3">
                <span class="fw-bold small mb-0"><i class="bi bi-calendar-heart me-1 text-danger"></i>Holidays • @DateTime.Today.ToString("MMMM yyyy")</span>
                <a asp-controller="Holiday" asp-action="Index" class="small text-decoration-none">Annual &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush small">
                    @if (Model.UpcomingHolidays.Any())
                    {
                        @foreach (var h in Model.UpcomingHolidays)
                        {
                            <div class="list-group-item px-3 py-1.5 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold text-truncate" style="max-width: 170px;">@h.Name</div>
                                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem; max-width: 170px;">@h.Description</small>
                                </div>
                                <span class="badge bg-danger-subtle text-danger text-nowrap" style="font-size: 0.7rem;">
                                    @(h.EndDate.HasValue ? $"{h.HolidayDate:dd}-{h.EndDate.Value:dd MMM}" : h.HolidayDate.ToString("dd MMM"))
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-2 text-center text-muted small">No holidays in @DateTime.Today.ToString("MMMM").</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Daily Trend Line Chart
        const ctxTrend = document.getElementById('dailyTrendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTrendDates)),
                datasets: [
                    {
                        label: 'Student %',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyStudentRates)),
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.08)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3
                    },
                    {
                        label: 'Teacher %',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTeacherRates)),
                        borderColor: '#10b981',
                        borderDash: [4, 4],
                        fill: false,
                        tension: 0.3,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 10, font: { size: 10 } }
                    }
                },
                scales: {
                    y: { beginAtZero: true, max: 100, ticks: { font: { size: 9 }, stepSize: 25 } },
                    x: { ticks: { font: { size: 9 } } }
                }
            }
        });

        // Today Ratio Doughnut Chart
        const ctxRatio = document.getElementById('todayRatioChart').getContext('2d');
        new Chart(ctxRatio, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent', 'Leave', 'Late'],
                datasets: [{
                    data: [@Model.PresentStudents, @Model.AbsentStudents, @Model.LeaveStudents, @Model.LateStudents],
                    backgroundColor: ['#10b981', '#ef4444', '#f59e0b', '#6366f1'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: '72%'
            }
        });
    });
</script>
}
