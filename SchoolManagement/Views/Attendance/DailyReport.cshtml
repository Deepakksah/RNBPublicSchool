@model SchoolManagement.ViewModels.DailySummaryViewModel
@{
    ViewData["Title"] = $"Daily Status - {Model.Date:dd MMMM yyyy}";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom no-print">
    <div>
        <h4 class="fw-bold mb-1">Daily Attendance & Operational Status</h4>
        <p class="text-muted small mb-0">Aggregate summary for <strong>@Model.Date.ToString("dddd, dd MMMM yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-primary">Change Date</button>
        </form>
        <button onclick="window.print()" class="btn btn-light border btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>

<!-- Print Header -->
<div class="print-header">
    <h2>@Model.School.Name</h2>
    <h4>Daily Attendance Summary Report</h4>
    <p>Date: @Model.Date.ToString("dd MMMM yyyy")</p>
</div>

<!-- Summary Cards for Students & Faculty -->
<div class="row g-4 mb-4">
    <!-- Student Summary -->
    <div class="col-lg-6">
        <div class="card card-custom p-4 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-people-fill me-2"></i>STUDENTS SUMMARY</h5>
                <span class="badge bg-primary fs-6">@Model.StudentAttendancePercentage%</span>
            </div>
            <div class="row g-2 text-center">
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted d-block small">Total</span>
                        <h4 class="fw-bold text-dark mb-0">@Model.TotalStudents</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-success-subtle rounded-3">
                        <span class="text-success d-block small">Present</span>
                        <h4 class="fw-bold text-success mb-0">@Model.StudentsPresent</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-danger-subtle rounded-3">
                        <span class="text-danger d-block small">Absent</span>
                        <h4 class="fw-bold text-danger mb-0">@Model.StudentsAbsent</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-warning-subtle rounded-3">
                        <span class="text-warning-emphasis d-block small">Leave / Late</span>
                        <h4 class="fw-bold text-warning-emphasis mb-0">@(Model.StudentsLeave + Model.StudentsLate)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Teacher Summary -->
    <div class="col-lg-6">
        <div class="card card-custom p-4 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-success mb-0"><i class="bi bi-person-badge-fill me-2"></i>TEACHERS SUMMARY</h5>
                <span class="badge bg-success fs-6">@Model.TeacherAttendancePercentage%</span>
            </div>
            <div class="row g-2 text-center">
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted d-block small">Total</span>
                        <h4 class="fw-bold text-dark mb-0">@Model.TotalTeachers</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-success-subtle rounded-3">
                        <span class="text-success d-block small">Present</span>
                        <h4 class="fw-bold text-success mb-0">@Model.TeachersPresent</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-danger-subtle rounded-3">
                        <span class="text-danger d-block small">Absent</span>
                        <h4 class="fw-bold text-danger mb-0">@Model.TeachersAbsent</h4>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-warning-subtle rounded-3">
                        <span class="text-warning-emphasis d-block small">Leave / Late</span>
                        <h4 class="fw-bold text-warning-emphasis mb-0">@(Model.TeachersLeave + Model.TeachersLate)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Class-wise Table -->
<div class="card card-custom">
    <div class="card-header-custom">
        <h6 class="fw-bold mb-0"><i class="bi bi-table me-2 text-primary"></i>Class-wise Attendance Distribution</h6>
    </div>
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Class Name</th>
                    <th>Section</th>
                    <th>Class Teacher</th>
                    <th>Enrolled Students</th>
                    <th>Present</th>
                    <th>Absent</th>
                    <th>Leave / Late</th>
                    <th>Attendance %</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ClassSummaries.Any())
                {
                    @foreach (var c in Model.ClassSummaries)
                    {
                        <tr>
                            <td class="fw-bold">@c.ClassName</td>
                            <td>Section @c.SectionName</td>
                            <td>@(c.ClassTeacherName ?? "<em class='text-muted'>Not Assigned</em>")</td>
                            <td>@c.TotalStudents</td>
                            <td><span class="badge bg-success-subtle text-success">@c.Present</span></td>
                            <td><span class="badge bg-danger-subtle text-danger">@c.Absent</span></td>
                            <td>@(c.Leave + c.Late)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar bg-primary" style="width: @c.AttendancePercentage%"></div>
                                    </div>
                                    <strong class="small">@c.AttendancePercentage%</strong>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">No classes active.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Print Signatures -->
<div class="print-footer-signatures">
    <div>
        ____________________________<br />
        Attendance Officer
    </div>
    <div>
        ____________________________<br />
        Principal Signature & Seal
    </div>
</div>
