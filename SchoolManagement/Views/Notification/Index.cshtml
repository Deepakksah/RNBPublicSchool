@model IEnumerable<SchoolManagement.Models.Notification>
@{
    ViewData["Title"] = "School Notifications";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Notices & Announcements</h4>
        <p class="text-muted small mb-0">Broadcast emergency alerts, holiday notices, and school circulars</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-megaphone-fill"></i>
            <span>Publish New Notice</span>
        </a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Notice Title</th>
                    <th>Category</th>
                    <th>Target Audience</th>
                    <th>Published Date</th>
                    <th>Created By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var n in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@n.Title</div>
                                <div class="text-muted small">@n.Description</div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary">@n.Type</span></td>
                            <td><span class="badge bg-light text-secondary border">@n.Audience</span></td>
                            <td>@n.PublishDate.ToString("dd MMM yyyy")</td>
                            <td>@(n.CreatedBy ?? "Admin")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@n.Id" method="post" onsubmit="return confirm('Delete this notice?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">No notices currently published.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
