@model SchoolManagement.ViewModels.StudentListViewModel
@{
    ViewData["Title"] = "Student Management";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Student Management Registry</h4>
        <p class="text-muted small mb-0">Total Enrolled Students: <strong>@Model.TotalCount.ToString("N0")</strong></p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span>Admit New Student</span>
        </a>
    </div>
</div>

<!-- Filters & Search Form -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Class</label>
            <select asp-for="SelectedClassId" asp-items="Model.Classes" class="form-select form-select-sm" id="filterClassSelect">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Section</label>
            <select asp-for="SelectedSectionId" asp-items="Model.Sections" class="form-select form-select-sm" id="filterSectionSelect">
                <option value="">-- All Sections --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Search Student</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input asp-for="SearchTerm" class="form-control" placeholder="Search by name, admission no, father's mobile..." />
            </div>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset">Reset</a>
        </div>
    </form>
</div>

<!-- Students Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Adm. No</th>
                    <th>Roll No</th>
                    <th>Class & Sec</th>
                    <th>Father Name</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Students.Any())
                {
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-img avatar-sm bg-light d-flex align-items-center justify-content-center border overflow-hidden">
                                        @if (!string.IsNullOrEmpty(s.Photo))
                                        {
                                            <img src="@s.Photo" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-primary small">@(s.Name.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@s.Id" class="fw-bold text-decoration-none text-dark">
                                            @s.Name
                                        </a>
                                        <div class="text-muted" style="font-size: 0.75rem;">@s.Gender, @(DateTime.Today.Year - s.DateOfBirth.Year) yrs</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@s.AdmissionNumber</span></td>
                            <td class="fw-bold">@s.RollNumber</td>
                            <td>@s.Class.Name - @s.Section.Name</td>
                            <td>@s.FatherName</td>
                            <td>@s.FatherMobile</td>
                            <td>
                                @if (s.Status == SchoolManagement.Models.StudentStatus.Active)
                                {
                                    <span class="badge badge-status badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-status badge-inactive">@s.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Action
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id"><i class="bi bi-eye me-2"></i>Profile & Attendance</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil me-2"></i>Edit Information</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Are you sure you want to mark this student as Left/Inactive?');">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete/Leave</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            No students found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sliding Window Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-center py-3 gap-2">
            <span class="text-muted small">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (Total: <strong>@Model.TotalCount.ToString("N0")</strong> students)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm" title="First Page">&laquo; First</a>
                </li>
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">Prev</a>
                </li>

                @{
                    int startPage = Math.Max(1, Model.PageIndex - 2);
                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm">Next</a>
                </li>
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-classId="@Model.SelectedClassId" asp-route-sectionId="@Model.SelectedSectionId" asp-route-search="@Model.SearchTerm" title="Last Page">Last &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
