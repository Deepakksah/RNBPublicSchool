@model SchoolManagement.ViewModels.StudentCreateEditViewModel
@{
    ViewData["Title"] = $"Edit Student — {Model.Name}";
}

<!-- Top Action Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-1 mb-1.5 border-bottom">
    <div class="d-flex align-items-center gap-1.5">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-light border text-muted py-0.5 px-1.5" style="font-size: 0.72rem;"><i class="bi bi-arrow-left"></i></a>
        <h6 class="fw-bold mb-0 text-dark" style="font-family: 'Outfit', sans-serif;">Edit Student Information — @Model.Name</h6>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0.5 px-1.5" style="font-size: 0.68rem;">Adm: @Model.AdmissionNumber</span>
        <span class="badge bg-success-subtle text-success border border-success-subtle py-0.5 px-1.5" style="font-size: 0.68rem;">Roll #@Model.RollNumber</span>
    </div>
    <div class="d-flex gap-1 mt-1 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-0.5 px-2 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
            <i class="bi bi-people"></i> Directory
        </a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm py-0.5 px-2 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
            <i class="bi bi-person-badge"></i> Profile
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="studentEditForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SchoolId" />
    <input type="hidden" asp-for="ExistingPhoto" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-1.5"></div>

    <div class="row g-1.5 mb-2">
        <!-- LEFT COLUMN: MAIN FORM DATA (72%) -->
        <div class="col-lg-8">
            <!-- 1. ACADEMIC ENROLLMENT & CLASSROOM -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary" style="font-size: 0.74rem;">
                        <i class="bi bi-mortarboard-fill me-1"></i> 1. Academic Enrollment & Classroom Allocation
                    </span>
                    <span class="badge bg-primary text-white py-0 px-1" style="font-size: 0.62rem;">Step 1</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-3">
                            <label asp-for="AcademicYearId" class="form-label text-muted">Academic Year</label>
                            <select asp-for="AcademicYearId" asp-items="Model.AcademicYears" class="form-select form-select-sm" required></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ClassId" class="form-label text-muted">Class *</label>
                            <select asp-for="ClassId" asp-items="Model.Classes" class="form-select form-select-sm fw-semibold" id="stuClassSelect" required></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="SectionId" class="form-label text-muted">Section *</label>
                            <select asp-for="SectionId" asp-items="Model.Sections" class="form-select form-select-sm fw-bold text-primary" id="stuSectionSelect" required></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="AdmissionNumber" class="form-label text-muted">Adm No *</label>
                            <input asp-for="AdmissionNumber" class="form-control form-control-sm fw-bold text-primary bg-light" id="stuAdmInput" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="RollNumber" class="form-label text-muted">Roll No *</label>
                            <input asp-for="RollNumber" class="form-control form-control-sm fw-bold text-success bg-light" id="stuRollInput" type="number" min="1" max="200" required />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. STUDENT BIO & IDENTITY -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary" style="font-size: 0.74rem;">
                        <i class="bi bi-person-badge-fill me-1"></i> 2. Student Identity & Personal Profile
                    </span>
                    <span class="badge bg-primary text-white py-0 px-1" style="font-size: 0.62rem;">Step 2</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label text-muted">Student Full Name *</label>
                            <input asp-for="Name" class="form-control form-control-sm fw-bold" id="stuNameInput" placeholder="Student name" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Gender" class="form-label text-muted">Gender *</label>
                            <select asp-for="Gender" class="form-select form-select-sm" id="stuGenderSelect" required>
                                <option value="Male">👦 Male</option>
                                <option value="Female">👧 Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="DateOfBirth" class="form-label text-muted">Date of Birth *</label>
                            <input asp-for="DateOfBirth" class="form-control form-control-sm" type="date" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="BloodGroup" class="form-label text-muted">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select form-select-sm" id="stuBloodSelect">
                                <option value="B+">B+</option>
                                <option value="O+">O+</option>
                                <option value="A+">A+</option>
                                <option value="AB+">AB+</option>
                                <option value="B-">B-</option>
                                <option value="O-">O-</option>
                                <option value="A-">A-</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. PARENTS & GUARDIAN DETAILS -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success" style="font-size: 0.74rem;">
                        <i class="bi bi-people-fill me-1"></i> 3. Parents & WhatsApp Contact
                    </span>
                    <span class="badge bg-success text-white py-0 px-1" style="font-size: 0.62rem;">Step 3</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-4">
                            <label asp-for="FatherName" class="form-label text-muted">Father's Name *</label>
                            <input asp-for="FatherName" class="form-control form-control-sm fw-semibold" id="stuFatherInput" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FatherMobile" class="form-label text-muted">Father's Mobile (WhatsApp) *</label>
                            <input asp-for="FatherMobile" class="form-control form-control-sm fw-bold text-dark" id="stuMobileInput" maxlength="10" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MotherName" class="form-label text-muted">Mother's Name *</label>
                            <input asp-for="MotherName" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MotherMobile" class="form-label text-muted">Mother's Mobile</label>
                            <input asp-for="MotherMobile" class="form-control form-control-sm" maxlength="10" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label text-muted">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-sm" placeholder="parent@email.com" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label text-muted">Status</label>
                            <select asp-for="Status" class="form-select form-select-sm fw-semibold">
                                <option value="1">Active Enrolled</option>
                                <option value="2">Inactive</option>
                                <option value="3">Transferred / TC</option>
                                <option value="4">Graduated</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. RESIDENTIAL LOCATION -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-warning-emphasis" style="font-size: 0.74rem;">
                        <i class="bi bi-geo-alt-fill me-1"></i> 4. Residential Address & City
                    </span>
                    <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.62rem;">Step 4</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label text-muted">Address *</label>
                            <input asp-for="Address" class="form-control form-control-sm" placeholder="Village / Ward / Street" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="City" class="form-label text-muted">City *</label>
                            <input asp-for="City" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="State" class="form-label text-muted">State *</label>
                            <input asp-for="State" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="PinCode" class="form-label text-muted">PIN *</label>
                            <input asp-for="PinCode" class="form-control form-control-sm" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: COMPACT LIVE STUDENT ID CARD PREVIEW (28%) -->
        <div class="col-lg-4">
            <!-- Student Live ID Card Widget -->
            <div class="card card-custom mb-1.5 border-primary shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);">
                <div class="card-header py-1 px-2.5 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%); border-top-left-radius: 4px; border-top-right-radius: 4px;">
                    <div class="d-flex align-items-center gap-1">
                        <img src="/uploads/schools/rnb-logo.jpg" style="width: 18px; height: 18px; border-radius: 50%; background: #fff;" onerror="this.src='/images/rnb-logo.jpg'" />
                        <span class="fw-bold" style="font-size: 0.72rem; font-family: 'Outfit', sans-serif;">R N B PUBLIC SCHOOL</span>
                    </div>
                    <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.6rem;">STUDENT ID</span>
                </div>
                <div class="card-body p-2 text-center">
                    <!-- Photo Circle with live preview & upload overlay -->
                    <div class="position-relative mx-auto mb-1.5" style="width: 68px; height: 68px;">
                        <div class="avatar-preview-box rounded-circle shadow-sm border border-2 border-primary overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 68px; height: 68px;">
                            <img id="stuPhotoPreview" src="@(string.IsNullOrEmpty(Model.ExistingPhoto) ? "/images/avatars/teacher-m1.svg" : Model.ExistingPhoto)" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <label for="stuPhotoInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle shadow cursor-pointer d-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.68rem; cursor: pointer;" title="Change Photo">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                    </div>

                    <!-- Hidden actual file input -->
                    <input asp-for="PhotoFile" class="d-none" type="file" accept="image/*" id="stuPhotoInput" />

                    <!-- Live Student Name & Badges -->
                    <h6 class="fw-bold text-dark mb-0 text-truncate" id="stuCardName" style="font-size: 0.84rem; font-family: 'Outfit', sans-serif;">@Model.Name</h6>
                    <div class="text-muted mb-1.5" style="font-size: 0.68rem;">
                        <span class="badge bg-primary-subtle text-primary border py-0 px-1 me-1" id="stuCardClass">Class & Section</span>
                        <span class="badge bg-success-subtle text-success border py-0 px-1" id="stuCardRoll">Roll #@Model.RollNumber</span>
                    </div>

                    <!-- Compact ID Details Grid -->
                    <div class="bg-white rounded border p-1.5 text-start mb-1.5" style="font-size: 0.70rem;">
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Adm No:</span>
                            <span class="fw-bold text-primary" id="stuCardAdm">@Model.AdmissionNumber</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Father:</span>
                            <span class="fw-semibold text-dark text-truncate" id="stuCardFather" style="max-width: 120px;">@Model.FatherName</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Contact:</span>
                            <span class="fw-semibold text-success" id="stuCardMobile">@Model.FatherMobile</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5">
                            <span class="text-muted">Blood:</span>
                            <span class="badge bg-danger text-white py-0 px-1" id="stuCardBlood">@(Model.BloodGroup ?? "B+")</span>
                        </div>
                    </div>

                    <div class="text-muted" style="font-size: 0.64rem;">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Station Road, Piro, Bhojpur (Bihar)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DOCKED STICKY ACTION BUTTON BAR -->
    <div class="card card-custom p-1.5 bg-white border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-1.5 sticky-bottom shadow-sm">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border btn-sm py-0.5 px-2.5 text-muted" style="font-size: 0.74rem;">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary btn-sm py-1 px-3.5 fw-bold shadow-sm" style="font-size: 0.78rem;">
            <i class="bi bi-check2-circle me-1"></i> Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateCard() {
                var name = $('#stuNameInput').val().trim();
                var adm = $('#stuAdmInput').val().trim();
                var roll = $('#stuRollInput').val().trim();
                var clsText = $('#stuClassSelect option:selected').text();
                var secText = $('#stuSectionSelect option:selected').text();
                var father = $('#stuFatherInput').val().trim();
                var mobile = $('#stuMobileInput').val().trim();
                var blood = $('#stuBloodSelect').val();

                $('#stuCardName').text(name || 'Student Name');
                $('#stuCardAdm').text(adm || '--');
                $('#stuCardRoll').text('Roll #' + (roll || '--'));
                $('#stuCardClass').text((clsText || 'Class') + ' - Sec ' + (secText || 'A'));
                $('#stuCardFather').text(father || '--');
                $('#stuCardMobile').text(mobile || '--');
                $('#stuCardBlood').text(blood || 'B+');
            }

            $('#stuNameInput, #stuAdmInput, #stuRollInput, #stuFatherInput, #stuMobileInput').on('input', updateCard);
            $('#stuClassSelect, #stuSectionSelect, #stuBloodSelect').on('change', updateCard);

            $('#stuPhotoInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (event) {
                        $('#stuPhotoPreview').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('#stuClassSelect').on('change', function () {
                var classId = $(this).val();
                var $sec = $('#stuSectionSelect');
                $sec.empty();
                if (classId) {
                    $.getJSON('/DEO/GetSections?classId=' + classId, function (data) {
                        $.each(data, function (i, item) {
                            $sec.append($('<option>', { value: item.id, text: item.name }));
                        });
                        $sec.trigger('change');
                        updateCard();
                    });
                }
            });

            updateCard();
        });
    </script>
}
