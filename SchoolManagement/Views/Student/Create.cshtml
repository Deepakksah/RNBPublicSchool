@model SchoolManagement.ViewModels.StudentCreateEditViewModel
@{
    ViewData["Title"] = "New Student Admission";
}

<!-- Top Action Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-1.5 mb-2 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-light border text-muted py-0.5 px-2"><i class="bi bi-arrow-left"></i></a>
            <h5 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">New Student Admission & Registration</h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0.5 px-2" style="font-size: 0.72rem;">Academic Portal</span>
        </div>
        <div class="text-muted small" style="font-size: 0.74rem;">Enter comprehensive student bio, academic assignment, parents contact, and residential address.</div>
    </div>
    <div class="d-flex gap-1.5 mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-1 px-2.5 d-flex align-items-center gap-1" style="font-size: 0.78rem;">
            <i class="bi bi-people"></i> Student Directory
        </a>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="studentCreateForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-2"></div>

    <div class="row g-2 mb-3">
        <!-- LEFT COLUMN: MAIN FORM DATA (70%) -->
        <div class="col-lg-8">
            <!-- 1. ACADEMIC ENROLLMENT -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary small">
                        <i class="bi bi-mortarboard-fill me-1"></i> 1. Academic Enrollment & Classroom Allocation
                    </span>
                    <span class="badge bg-primary text-white" style="font-size: 0.68rem;">Step 1</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label asp-for="AcademicYearId" class="form-label small fw-semibold text-muted">Academic Year</label>
                            <select asp-for="AcademicYearId" asp-items="Model.AcademicYears" class="form-select form-select-sm" required></select>
                            <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ClassId" class="form-label small fw-semibold text-muted">Class / Standard *</label>
                            <select asp-for="ClassId" asp-items="Model.Classes" class="form-select form-select-sm fw-semibold text-dark" id="stuClassSelect" required></select>
                            <span asp-validation-for="ClassId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="SectionId" class="form-label small fw-semibold text-muted">Section *</label>
                            <select asp-for="SectionId" asp-items="Model.Sections" class="form-select form-select-sm fw-bold text-primary" id="stuSectionSelect" required></select>
                            <span asp-validation-for="SectionId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="AdmissionNumber" class="form-label small fw-semibold text-muted">Adm. Number *</label>
                            <input asp-for="AdmissionNumber" class="form-control form-control-sm fw-bold text-primary bg-light" id="stuAdmInput" required />
                            <span asp-validation-for="AdmissionNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="RollNumber" class="form-label small fw-semibold text-muted">Roll No. *</label>
                            <input asp-for="RollNumber" class="form-control form-control-sm fw-bold text-success bg-light" id="stuRollInput" type="number" min="1" max="200" required />
                            <span asp-validation-for="RollNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. STUDENT BIO & IDENTITY -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary small">
                        <i class="bi bi-person-badge-fill me-1"></i> 2. Student Identity & Personal Profile
                    </span>
                    <span class="badge bg-primary text-white" style="font-size: 0.68rem;">Step 2</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label small fw-semibold text-muted">Student Full Name *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-primary"></i></span>
                                <input asp-for="Name" class="form-control form-control-sm fw-bold" id="stuNameInput" placeholder="e.g. Ananya Kumari Singh" required autofocus autocomplete="off" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label small fw-semibold text-muted">Gender *</label>
                            <select asp-for="Gender" class="form-select form-select-sm" id="stuGenderSelect" required>
                                <option value="Male">👦 Male</option>
                                <option value="Female">👧 Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label small fw-semibold text-muted">Date of Birth *</label>
                            <input asp-for="DateOfBirth" class="form-control form-control-sm" type="date" required />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BloodGroup" class="form-label small fw-semibold text-muted">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select form-select-sm" id="stuBloodSelect">
                                <option value="B+">B+</option>
                                <option value="O+">O+</option>
                                <option value="A+">A+</option>
                                <option value="AB+">AB+</option>
                                <option value="B-">B-</option>
                                <option value="O-">O-</option>
                                <option value="A-">A-</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AdmissionDate" class="form-label small fw-semibold text-muted">Date of Admission *</label>
                            <input asp-for="AdmissionDate" class="form-control form-control-sm" type="date" required />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. PARENTS & GUARDIAN DETAILS -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success small">
                        <i class="bi bi-people-fill me-1"></i> 3. Parents & Emergency Contact
                    </span>
                    <span class="badge bg-success text-white" style="font-size: 0.68rem;">Step 3</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="FatherName" class="form-label small fw-semibold text-muted">Father's Full Name *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-person-fill text-muted"></i></span>
                                <input asp-for="FatherName" class="form-control form-control-sm fw-semibold" id="stuFatherInput" placeholder="Father's name" required />
                            </div>
                            <span asp-validation-for="FatherName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FatherMobile" class="form-label small fw-semibold text-muted">Father's Mobile (WhatsApp) *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-success"></i></span>
                                <input asp-for="FatherMobile" class="form-control form-control-sm fw-bold" id="stuMobileInput" placeholder="10-digit mobile" maxlength="10" required />
                            </div>
                            <span asp-validation-for="FatherMobile" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MotherName" class="form-label small fw-semibold text-muted">Mother's Full Name *</label>
                            <input asp-for="MotherName" class="form-control form-control-sm" placeholder="Mother's name" required />
                            <span asp-validation-for="MotherName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MotherMobile" class="form-label small fw-semibold text-muted">Mother's Mobile (Optional)</label>
                            <input asp-for="MotherMobile" class="form-control form-control-sm" placeholder="Optional phone number" maxlength="10" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. RESIDENTIAL LOCATION -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-warning-emphasis small">
                        <i class="bi bi-geo-alt-fill me-1"></i> 4. Residential Address & City
                    </span>
                    <span class="badge bg-warning text-dark" style="font-size: 0.68rem;">Step 4</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label small fw-semibold text-muted">Street / Village / Ward Address *</label>
                            <input asp-for="Address" class="form-control form-control-sm" placeholder="Village / Ward / Street Address" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="City" class="form-label small fw-semibold text-muted">City / Block *</label>
                            <input asp-for="City" class="form-control form-control-sm" value="Piro" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="State" class="form-label small fw-semibold text-muted">State *</label>
                            <input asp-for="State" class="form-control form-control-sm" value="Bihar" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="PinCode" class="form-label small fw-semibold text-muted">PIN Code *</label>
                            <input asp-for="PinCode" class="form-control form-control-sm" value="802207" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: LIVE STUDENT ID CARD PREVIEW (30%) -->
        <div class="col-lg-4">
            <!-- Student Live ID Card Widget -->
            <div class="card card-custom mb-2 border-primary shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);">
                <div class="card-header py-1.5 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%); border-top-left-radius: 6px; border-top-right-radius: 6px;">
                    <div class="d-flex align-items-center gap-1.5">
                        <img src="/uploads/schools/rnb-logo.jpg" style="width: 22px; height: 22px; border-radius: 50%; background: #fff;" onerror="this.src='/images/rnb-logo.jpg'" />
                        <span class="fw-bold small" style="font-family: 'Outfit', sans-serif;">R N B PUBLIC SCHOOL</span>
                    </div>
                    <span class="badge bg-warning text-dark py-0.5 px-1.5" style="font-size: 0.65rem;">STUDENT ID</span>
                </div>
                <div class="card-body p-3 text-center">
                    <!-- Photo Circle with live preview & upload overlay -->
                    <div class="position-relative mx-auto mb-2" style="width: 82px; height: 82px;">
                        <div class="avatar-preview-box rounded-circle shadow-sm border border-2 border-primary overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 82px; height: 82px;">
                            <img id="stuPhotoPreview" src="/images/avatars/teacher-f1.svg" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <label for="stuPhotoInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-1 shadow cursor-pointer" style="width: 26px; height: 26px; font-size: 0.75rem; cursor: pointer;" title="Upload Photo">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                    </div>

                    <!-- Hidden actual file input -->
                    <input asp-for="PhotoFile" class="d-none" type="file" accept="image/*" id="stuPhotoInput" />

                    <!-- Live Student Name & Badges -->
                    <h6 class="fw-bold text-dark mb-0" id="stuCardName" style="font-family: 'Outfit', sans-serif;">Student Name</h6>
                    <div class="text-muted small mb-2" style="font-size: 0.72rem;">
                        <span class="badge bg-primary-subtle text-primary border me-1" id="stuCardClass">Class & Section</span>
                        <span class="badge bg-success-subtle text-success border" id="stuCardRoll">Roll #--</span>
                    </div>

                    <!-- Compact ID Details Grid -->
                    <div class="bg-white rounded border p-2 text-start small mb-2" style="font-size: 0.74rem;">
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Admission No:</span>
                            <span class="fw-bold text-primary" id="stuCardAdm">@Model.AdmissionNumber</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Father Name:</span>
                            <span class="fw-semibold text-dark text-truncate" id="stuCardFather" style="max-width: 130px;">--</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Contact:</span>
                            <span class="fw-semibold text-success" id="stuCardMobile">--</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5">
                            <span class="text-muted">Blood Group:</span>
                            <span class="badge bg-danger text-white py-0 px-1" id="stuCardBlood">B+</span>
                        </div>
                    </div>

                    <div class="text-muted" style="font-size: 0.68rem;">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Station Road, Piro, Bhojpur (Bihar)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DOCKED STICKY ACTION BUTTON BAR -->
    <div class="card card-custom p-2 bg-white border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 sticky-bottom shadow">
        <a asp-action="Index" class="btn btn-light border btn-sm py-1 px-3 text-muted" style="font-size: 0.78rem;">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary btn-sm py-1.5 px-4 fw-bold shadow-sm" style="font-size: 0.8rem;">
            <i class="bi bi-person-check-fill me-1"></i> Complete Student Admission
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateCard() {
                var name = $('#stuNameInput').val().trim();
                var adm = $('#stuAdmInput').val().trim();
                var roll = $('#stuRollInput').val().trim();
                var clsText = $('#stuClassSelect option:selected').text();
                var secText = $('#stuSectionSelect option:selected').text();
                var father = $('#stuFatherInput').val().trim();
                var mobile = $('#stuMobileInput').val().trim();
                var blood = $('#stuBloodSelect').val();

                $('#stuCardName').text(name || 'Student Name');
                $('#stuCardAdm').text(adm || '--');
                $('#stuCardRoll').text('Roll #' + (roll || '--'));
                $('#stuCardClass').text((clsText || 'Class') + ' - Sec ' + (secText || 'A'));
                $('#stuCardFather').text(father || '--');
                $('#stuCardMobile').text(mobile || '--');
                $('#stuCardBlood').text(blood || 'B+');
            }

            $('#stuNameInput, #stuAdmInput, #stuRollInput, #stuFatherInput, #stuMobileInput').on('input', updateCard);
            $('#stuClassSelect, #stuSectionSelect, #stuBloodSelect').on('change', updateCard);

            $('#stuPhotoInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (event) {
                        $('#stuPhotoPreview').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('#stuClassSelect').on('change', function () {
                var classId = $(this).val();
                var $sec = $('#stuSectionSelect');
                $sec.empty();
                if (classId) {
                    $.getJSON('/DEO/GetSections?classId=' + classId, function (data) {
                        $.each(data, function (i, item) {
                            $sec.append($('<option>', { value: item.id, text: item.name }));
                        });
                        $sec.trigger('change');
                        updateCard();
                    });
                }
            });

            updateCard();
        });
    </script>
}
