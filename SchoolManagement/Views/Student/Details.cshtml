@model SchoolManagement.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = $"{Model.Student.Name} - Student Profile";
}

<!-- Top Action Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-2 mb-2 border-bottom no-print">
    <div>
        <h5 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">Student Cumulative Profile</h5>
        <div class="text-muted small" style="font-size: 0.78rem;">
            Admission No: <strong class="text-dark">@Model.Student.AdmissionNumber</strong> • Roll: <strong class="text-dark">@Model.Student.RollNumber</strong> • Class: <strong class="text-dark">@Model.Student.Class.Name - @Model.Student.Section.Name</strong>
        </div>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Edit" asp-route-id="@Model.Student.Id" class="btn btn-outline-primary btn-sm py-1 px-3 d-flex align-items-center gap-1 fw-semibold">
            <i class="bi bi-pencil"></i> Edit Profile
        </a>
        <button onclick="window.print()" class="btn btn-light border btn-sm py-1 px-3 d-flex align-items-center gap-1">
            <i class="bi bi-printer"></i> Print Record
        </button>
    </div>
</div>

<!-- Print Header (Hidden on screen) -->
<div class="print-header">
    <h2>@Model.Student.School.Name</h2>
    <h4>Student Cumulative Profile & Attendance Sheet</h4>
    <p>Generated on @DateTime.Today.ToString("dd MMMM yyyy")</p>
</div>

<!-- Compact Student Bio Card -->
<div class="card card-custom p-3 mb-2">
    <div class="row g-3 align-items-center">
        <!-- Avatar & Core Identity -->
        <div class="col-md-3 text-center text-md-start border-end pe-md-3">
            <div class="d-flex flex-md-column align-items-center align-items-md-start gap-2">
                <div class="avatar-img bg-light border d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" style="width: 64px; height: 64px; border-radius: 50%;">
                    @if (!string.IsNullOrEmpty(Model.Student.Photo))
                    {
                        <img src="@Model.Student.Photo" alt="@Model.Student.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="fs-4 fw-bold text-primary">@(Model.Student.Name.Substring(0, 1).ToUpper())</span>
                    }
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">@Model.Student.Name</h6>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">Class @Model.Student.Class.Name - @Model.Student.Section.Name</span>
                        @if (Model.Student.Status == SchoolManagement.Models.StudentStatus.Active)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger" style="font-size: 0.68rem;">@Model.Student.Status</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="col-md-9 ps-md-3">
            <div class="row g-2" style="font-size: 0.8rem;">
                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Admission No:</span>
                    <strong class="text-dark">@Model.Student.AdmissionNumber</strong>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Class Roll No:</span>
                    <strong class="text-dark">@Model.Student.RollNumber</strong>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Academic Session:</span>
                    <strong class="text-dark">@Model.Student.AcademicYear.Name</strong>
                </div>

                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Date of Birth:</span>
                    <strong class="text-dark">@Model.Student.DateOfBirth.ToString("dd MMM yyyy")</strong>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Gender / Blood Group:</span>
                    <strong class="text-dark">@Model.Student.Gender (@(Model.Student.BloodGroup ?? "N/A"))</strong>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Admission Date:</span>
                    <strong class="text-dark">@Model.Student.AdmissionDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="col-12 border-top pt-1 mt-1"></div>

                <div class="col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Father's Name:</span>
                    <strong class="text-dark">@Model.Student.FatherName</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Mother's Name:</span>
                    <strong class="text-dark">@(Model.Student.MotherName ?? "N/A")</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted d-block" style="font-size: 0.72rem;">Primary Mobile:</span>
                    <strong class="text-dark"><i class="bi bi-telephone text-muted me-1"></i>@Model.Student.FatherMobile</strong>
                </div>

                <div class="col-12">
                    <span class="text-muted" style="font-size: 0.72rem;">Residential Address: </span>
                    <span class="text-dark">@Model.Student.Address, @Model.Student.City, @Model.Student.State - @Model.Student.PinCode</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance KPI Cards (Compact Row) -->
<div class="row g-2 mb-2">
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-blue py-2 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">TOTAL WORKING DAYS</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.TotalWorkingDays</div>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;"><i class="bi bi-calendar-range"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-green py-2 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">PRESENT DAYS</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.PresentDays</div>
                <small class="text-white-50" style="font-size: 0.68rem;">@Model.AttendancePercentage% Rate</small>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;"><i class="bi bi-check2-circle"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-red py-2 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">ABSENT DAYS</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.AbsentDays</div>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;"><i class="bi bi-x-circle"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-amber py-2 px-3">
            <div>
                <div class="kpi-title" style="font-size: 0.7rem;">LEAVE / LATE</div>
                <div class="kpi-value" style="font-size: 1.35rem; line-height: 1.1;">@Model.LeaveDays / @Model.LateDays</div>
            </div>
            <div class="kpi-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;"><i class="bi bi-clock-history"></i></div>
        </div>
    </div>
</div>

<!-- Monthly Attendance Breakdown & Recent Logs -->
<div class="row g-2">
    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header-custom py-1.5 px-3">
                <span class="fw-bold small mb-0"><i class="bi bi-bar-chart me-1 text-primary"></i>Monthly Attendance Breakdown</span>
            </div>
            <div class="table-responsive">
                <table class="table-custom mb-0" style="font-size: 0.8rem;">
                    <thead>
                        <tr>
                            <th class="py-1">Month</th>
                            <th class="py-1">Total</th>
                            <th class="py-1">Present</th>
                            <th class="py-1">Absent</th>
                            <th class="py-1">Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MonthlyAttendances.Any())
                        {
                            @foreach (var m in Model.MonthlyAttendances)
                            {
                                <tr>
                                    <td class="fw-semibold py-1">@m.MonthName</td>
                                    <td class="py-1">@m.TotalDays</td>
                                    <td class="py-1"><span class="badge bg-success-subtle text-success py-0.5 px-1.5">@m.Present</span></td>
                                    <td class="py-1"><span class="badge bg-danger-subtle text-danger py-0.5 px-1.5">@m.Absent</span></td>
                                    <td class="py-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 5px; width: 45px;">
                                                <div class="progress-bar bg-success" style="width: @m.Percentage%"></div>
                                            </div>
                                            <small class="fw-bold" style="font-size: 0.72rem;">@m.Percentage%</small>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-3 text-muted small">No attendance logs found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header-custom py-1.5 px-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold small mb-0"><i class="bi bi-clock-history me-1 text-primary"></i>Recent Attendance Logs</span>
                <small class="text-muted" style="font-size: 0.7rem;">Last 30 records</small>
            </div>
            <div class="card-body p-0" style="max-height: 220px; overflow-y: auto;">
                <div class="list-group list-group-flush small" style="font-size: 0.78rem;">
                    @if (Model.RecentAttendances.Any())
                    {
                        @foreach (var att in Model.RecentAttendances)
                        {
                            var bClass = att.Status == SchoolManagement.Models.AttendanceStatus.Present ? "badge-present" :
                                         att.Status == SchoolManagement.Models.AttendanceStatus.Absent ? "badge-absent" : "badge-leave";
                            <div class="list-group-item px-3 py-1 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@att.AttendanceDate.ToString("dddd, dd MMMM yyyy")</div>
                                    @if (!string.IsNullOrEmpty(att.Remarks))
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.68rem;">@att.Remarks</small>
                                    }
                                </div>
                                <span class="badge badge-status @bClass py-0.5 px-2" style="font-size: 0.68rem;">@att.Status</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">No recent records.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
