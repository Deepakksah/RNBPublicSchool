<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — R N B Public School, Piro</title>

    <!-- Official School Logo Favicons -->
    <link rel="icon" type="image/jpeg" href="~/images/rnb-logo.jpg" />
    <link rel="shortcut icon" type="image/jpeg" href="~/images/rnb-logo.jpg" />
    <link rel="apple-touch-icon" href="~/images/rnb-logo.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_ToastNotificationPartial" />

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-wrapper">
            <partial name="_Sidebar" />
            <div class="app-main">
                <partial name="_Navbar" />
                <main class="page-content" role="main">
                    @RenderBody()
                </main>
                <partial name="_Footer" />
            </div>
        </div>
    }
    else
    {
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    }

    <!-- jQuery, Bootstrap 5 JS & Chart.js -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Application Script -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/attendance.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
