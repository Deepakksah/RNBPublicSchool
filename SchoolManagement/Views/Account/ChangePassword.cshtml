@model SchoolManagement.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid max-w-lg py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1">Security & Password</h4>
            <p class="text-muted small mb-0">Update your account password</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card card-custom p-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small"></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" required />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
