@model SchoolManagement.ViewModels.SchoolCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Edit School Profile</h4>
        <p class="text-muted small mb-0">Update metadata and administrative details</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Details
    </a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="row g-4">
        <!-- School Basic Info -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="bi bi-building me-2"></i>School Identity</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold small"></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label fw-semibold small"></label>
                        <input asp-for="Code" class="form-control text-uppercase" required />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RegistrationNumber" class="form-label fw-semibold small"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EstablishedYear" class="form-label fw-semibold small"></label>
                        <input asp-for="EstablishedYear" class="form-control" type="number" />
                        <span asp-validation-for="EstablishedYear" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoFile" class="form-label fw-semibold small"></label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                        {
                            <div class="mt-2"><img src="@Model.ExistingLogo" alt="Current Logo" style="height: 40px;" /></div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BannerFile" class="form-label fw-semibold small"></label>
                        <input asp-for="BannerFile" type="file" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ExistingBanner))
                        {
                            <div class="mt-2"><img src="@Model.ExistingBanner" alt="Current Banner" style="height: 40px;" /></div>
                        }
                    </div>
                </div>

                <h5 class="fw-bold my-4 border-bottom pb-2 text-primary"><i class="bi bi-geo-alt me-2"></i>Contact & Location</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-semibold small"></label>
                        <input asp-for="City" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label fw-semibold small"></label>
                        <input asp-for="State" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PinCode" class="form-label fw-semibold small"></label>
                        <input asp-for="PinCode" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Phone" class="form-label fw-semibold small"></label>
                        <input asp-for="Phone" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Website" class="form-label fw-semibold small"></label>
                        <input asp-for="Website" class="form-control" />
                    </div>
                </div>

                <h5 class="fw-bold my-4 border-bottom pb-2 text-primary"><i class="bi bi-card-text me-2"></i>Vision & Philosophy</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="About" class="form-label fw-semibold small"></label>
                        <textarea asp-for="About" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Vision" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Vision" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Mission" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Mission" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Principal Section & Actions -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="bi bi-person-workspace me-2"></i>Principal Profile</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="PrincipalName" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalName" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalPhotoFile" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalPhotoFile" type="file" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ExistingPrincipalPhoto))
                        {
                            <div class="mt-2"><img src="@Model.ExistingPrincipalPhoto" alt="Principal" style="height: 40px; border-radius: 50%;" /></div>
                        }
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalQualification" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalQualification" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalExperience" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalExperience" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalPhone" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalPhone" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalEmail" class="form-label fw-semibold small"></label>
                        <input asp-for="PrincipalEmail" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PrincipalMessage" class="form-label fw-semibold small"></label>
                        <textarea asp-for="PrincipalMessage" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="card card-custom p-4">
                <label asp-for="Status" class="form-label fw-semibold small">Operational Status</label>
                <select asp-for="Status" class="form-select mb-4">
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Suspended</option>
                    <option value="4">Under Maintenance</option>
                </select>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</form>
