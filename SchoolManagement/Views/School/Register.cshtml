@model SchoolManagement.Models.AdmissionInquiry
@{
    var school = ViewBag.School as SchoolManagement.Models.School;
    ViewData["Title"] = $"Online Admission Registration (2026-27) — {school?.Name ?? "R N B Public School"}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Admission Registration (Session 2026-2027) — @(school?.Name ?? "R N B Public School, Piro")</title>
    <meta name="description" content="Apply online for admission in Nursery to Class 10 at @(school?.Name ?? "R N B Public School, Piro (Bhojpur, Bihar)"). Submit student registration details online for fast admission confirmation." />
    <meta name="keywords" content="RNB Public School Online Admission, School Registration Piro, Admission 2026 2027 Piro Bhojpur, English Medium school admission Bihar" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://rnbpublicschool.com/School/Register/@(school?.Code ?? "RNB-PIRO")" />

    <!-- Open Graph Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Online Admission Form 2026-2027 — @(school?.Name ?? "R N B Public School, Piro")" />
    <meta property="og:description" content="Fast online admission registration form for session 2026-2027 at R N B Public School, Piro." />
    <meta property="og:image" content="https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Schema.org JSON-LD for Admission Portal -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": "Online Admission Registration 2026-2027",
      "description": "Online student registration and admission inquiry form for R N B Public School, Piro.",
      "breadcrumb": {
        "@@type": "BreadcrumbList",
        "itemListElement": [
          { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://rnbpublicschool.com/School/PublicProfile/@(school?.Code ?? "RNB-PIRO")" },
          { "@@type": "ListItem", "position": 2, "name": "Online Admission", "item": "https://rnbpublicschool.com/School/Register/@(school?.Code ?? "RNB-PIRO")" }
        ]
      }
    }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
        }

        .header-top {
            background: linear-gradient(135deg, #0b0f19 0%, #1e3a8a 100%);
            color: #ffffff;
            padding: 1.5rem 0;
            border-bottom: 3px solid #f59e0b;
        }

        .registration-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            margin-top: -30px;
            margin-bottom: 3rem;
        }

        .form-section-title {
            font-size: 0.88rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #1e3a8a;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.5rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.25rem;
        }

        .form-control, .form-select {
            font-size: 0.9rem;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 0.5rem 0.75rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .btn-submit {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 0.75rem 2rem;
            border-radius: 10px;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.3);
            color: #ffffff;
        }
    </style>
</head>
<body>

    <!-- Header (Strictly Public) -->
    <header class="header-top shadow-sm">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <img src="/uploads/schools/rnb-logo.jpg" alt="Logo" style="width: 60px; height: 60px; object-fit: contain; border-radius: 50%; background: #fff; padding: 2px;" class="border" onerror="this.src='/images/rnb-logo.jpg'" />
                <div>
                    <h3 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">@(school?.Name ?? "R N B Public School, Piro")</h3>
                    <div class="small opacity-75">8CM3+PH4, Station Road, Piro, Bhojpur, Bihar 802207 • Helpline: 094708 35418 / 09661160546</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/School/Profile/@(school?.Code ?? "RNB-PIRO")" class="btn btn-outline-light btn-sm px-3 fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Back to School Website
                </a>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="registration-card p-4 p-md-5">
            <!-- Title -->
            <div class="text-center mb-4">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 fw-bold mb-2">
                    <i class="bi bi-star-fill me-1"></i> ADMISSIONS OPEN FOR SESSION 2026-2027
                </span>
                <h2 class="fw-bold" style="font-family: 'Outfit', sans-serif; color: #1e3a8a;">Online Student Registration & Admission Inquiry</h2>
                <p class="text-muted small mx-auto" style="max-width: 650px;">
                    Fill out the official registration form below. Once submitted, your inquiry is directly sent to the school admission desk, and our team will get in touch with you.
                </p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show p-3 mb-4 shadow-sm" role="alert">
                    <h5 class="alert-heading fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Inquiry Submitted Successfully!</h5>
                    <p class="mb-0 small">@TempData["SuccessMessage"]</p>
                    <hr />
                    <div class="d-flex gap-2">
                        <a href="/School/Profile/@(school?.Code ?? "RNB-PIRO")" class="btn btn-success btn-sm fw-bold">Return to School Website</a>
                    </div>
                </div>
            }

            <form asp-action="SubmitInquiry" method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SchoolId" />

                <!-- SECTION 1: STUDENT INFORMATION -->
                <div class="form-section-title">
                    <i class="bi bi-person-fill"></i> 1. Student Basic Information
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StudentName" class="form-label required">Student Full Name *</label>
                        <input asp-for="StudentName" class="form-control" placeholder="Enter student's full name" required />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ApplyingForClass" class="form-label required">Applying for Class *</label>
                        <select asp-for="ApplyingForClass" class="form-select" required>
                            <option value="">-- Select Class --</option>
                            <option value="Nursery">Nursery</option>
                            <option value="LKG">LKG</option>
                            <option value="UKG">UKG</option>
                            <option value="Class 1">Class 1</option>
                            <option value="Class 2">Class 2</option>
                            <option value="Class 3">Class 3</option>
                            <option value="Class 4">Class 4</option>
                            <option value="Class 5">Class 5</option>
                            <option value="Class 6">Class 6</option>
                            <option value="Class 7">Class 7</option>
                            <option value="Class 8">Class 8</option>
                            <option value="Class 9">Class 9</option>
                            <option value="Class 10">Class 10</option>
                        </select>
                        <span asp-validation-for="ApplyingForClass" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Gender" class="form-label required">Gender *</label>
                        <select asp-for="Gender" class="form-select" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label required">Date of Birth *</label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="PreviousSchool" class="form-label">Previous School Attended (if applicable)</label>
                        <input asp-for="PreviousSchool" class="form-control" placeholder="Name of previous school and city" />
                    </div>
                </div>

                <!-- SECTION 2: PARENT & CONTACT DETAILS -->
                <div class="form-section-title">
                    <i class="bi bi-people-fill"></i> 2. Parent & Contact Details (Required)
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FatherName" class="form-label required">Father's / Guardian's Full Name *</label>
                        <input asp-for="FatherName" class="form-control" placeholder="Enter father's name" required />
                        <span asp-validation-for="FatherName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FatherMobile" class="form-label required">Contact Mobile Number (WhatsApp) *</label>
                        <input asp-for="FatherMobile" class="form-control" placeholder="e.g. 9470835418" required />
                        <span asp-validation-for="FatherMobile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MotherName" class="form-label">Mother's Full Name</label>
                        <input asp-for="MotherName" class="form-control" placeholder="Enter mother's name" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email Address (Optional)</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="e.g. parent@example.com" />
                    </div>
                </div>

                <!-- SECTION 3: ADDRESS & LOCATION -->
                <div class="form-section-title">
                    <i class="bi bi-geo-alt-fill"></i> 3. Residential Address / Location
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label required">Street / Village / Mohalla Address *</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter full residential address" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="City" class="form-label">City / Block</label>
                        <input asp-for="City" class="form-control" value="Piro" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" value="Bihar" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="PinCode" class="form-label">PIN Code</label>
                        <input asp-for="PinCode" class="form-control" value="802207" />
                    </div>
                    <div class="col-12">
                        <label asp-for="QueryMessage" class="form-label">Any Questions or Specific Inquiries?</label>
                        <textarea asp-for="QueryMessage" class="form-control" rows="2" placeholder="e.g. Inquiring regarding transport facility, fee structure, hostel, etc."></textarea>
                    </div>
                </div>

                <!-- SUBMIT BUTTON -->
                <div class="text-center pt-3 border-top">
                    <button type="submit" class="btn btn-submit shadow">
                        <i class="bi bi-send-fill me-1"></i> Submit Online Registration / Admission Inquiry
                    </button>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-shield-check text-success me-1"></i> All submitted information is confidential and sent directly to R N B Public School Admissions Office.
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
