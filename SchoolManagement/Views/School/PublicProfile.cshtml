@model SchoolManagement.ViewModels.SchoolPublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.School.Name} - Official Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-IN" prefix="og: https://ogp.me/ns#">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>@Model.School.Name, Piro | Best English Medium CBSE School in Bhojpur Bihar</title>
    <meta name="title" content="@Model.School.Name, Piro | Best English Medium CBSE School in Bhojpur Bihar" />
    <meta name="description" content="Welcome to @Model.School.Name, Piro (Bhojpur, Bihar). Leading co-educational institution providing holistic quality education from Nursery to Class 10 with Smart Classrooms, Science & Computer Labs, Sports, and Experienced Faculty. Admissions Open 2026-2027!" />
    <meta name="keywords" content="RNB Public School, RNB School Piro, Best school in Piro, Schools in Bhojpur Bihar, CBSE English Medium school Piro, RNB Public School Admission, Best co-ed school in Bhojpur, Top school in Piro Bihar, RNB Piro, Education in Bhojpur" />
    <meta name="author" content="@Model.School.Name Administration" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code" />

    <!-- Geo & Local SEO Meta Tags -->
    <meta name="geo.region" content="IN-BR" />
    <meta name="geo.placename" content="Piro, Bhojpur, Bihar" />
    <meta name="geo.position" content="25.3315;84.4124" />
    <meta name="ICBM" content="25.3315, 84.4124" />

    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content="school" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="@Model.School.Name, Piro" />
    <meta property="og:title" content="@Model.School.Name, Piro — Admissions Open 2026-27" />
    <meta property="og:description" content="Explore quality education, modern labs, sports, and smart classrooms at @Model.School.Name, Piro. Apply online for admission today!" />
    <meta property="og:url" content="https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code" />
    <meta property="og:image" content="https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg" />
    <meta property="og:image:alt" content="@Model.School.Name Campus & Official Emblem" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.School.Name, Piro (Bhojpur)" />
    <meta name="twitter:description" content="Premier English Medium Co-educational institution in Piro, Bhojpur, Bihar. Admissions Open 2026-2027." />
    <meta name="twitter:image" content="https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Schema.org JSON-LD Structured Data for School & Local Business -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": ["School", "EducationalOrganization"],
      "name": "@Model.School.Name",
      "legalName": "@Model.School.Name",
      "description": "Leading English Medium co-educational institution in Piro, Bhojpur, Bihar offering holistic education from Nursery to Class 10.",
      "url": "https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code",
      "logo": "https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg",
      "image": "https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg",
      "telephone": "+91-9470835418",
      "email": "info@rnbpublicschool.com",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Station Road, Piro",
        "addressLocality": "Piro",
        "addressRegion": "Bihar",
        "postalCode": "802207",
        "addressCountry": "IN"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": 25.3315,
        "longitude": 84.4124
      },
      "openingHoursSpecification": [
        {
          "@@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "07:30",
          "closes": "14:00"
        }
      ],
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "Academic Curriculum",
        "itemListElement": [
          { "@@type": "Offer", "itemOffered": { "@@type": "Service", "name": "Pre-Primary Wing (Nursery, LKG, UKG)" } },
          { "@@type": "Offer", "itemOffered": { "@@type": "Service", "name": "Primary & Middle School (Class 1 to 8)" } },
          { "@@type": "Offer", "itemOffered": { "@@type": "Service", "name": "Secondary School (Class 9 & 10)" } }
        ]
      }
    }
    </script>

    <!-- Schema.org FAQPage Structured Data -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "What is the admission procedure at R N B Public School, Piro?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Parents can apply online through the official Online Admission portal or visit the school admission desk on Station Road, Piro with child's Birth Certificate and Aadhaar card."
          }
        },
        {
          "@@type": "Question",
          "name": "Which classes are offered at R N B Public School?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "R N B Public School offers education from Nursery, LKG, UKG up to Class 10 with CBSE aligned curriculum, smart classes, science lab, computer lab, and library."
          }
        },
        {
          "@@type": "Question",
          "name": "What are the school office hours?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "The school office is open Monday to Saturday from 7:30 AM to 2:00 PM. Helpline: +91 94708 35418."
          }
        }
      ]
    }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; color: #1e293b; background-color: #f8fafc; }
        h1, h2, h3, h4, h5, .brand-font { font-family: 'Outfit', sans-serif; }
        .hero-banner {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(30, 58, 138, 0.88)), url('/uploads/schools/rnb-logo.jpg');
            background-size: cover;
            background-position: center;
            color: #ffffff;
            padding: 5rem 1rem 4rem;
        }
        .stat-badge-card {
            background: #ffffff;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);
            text-align: center;
            border: 1px solid #e2e8f0;
            margin-top: -3rem;
        }
        .feature-icon-circle {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        .gallery-card img {
            height: 200px;
            object-fit: cover;
            border-radius: 0.75rem;
            transition: transform 0.3s ease;
        }
        .gallery-card:hover img {
            transform: scale(1.03);
        }
        .school-hero-img-box {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #fff;
            padding: 4px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            margin: 0 auto 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .school-hero-img-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 50%;
        }
    </style>
</head>
<body>
    <!-- Top Nav -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-3" href="#">
                <img src="/uploads/schools/rnb-logo.jpg" alt="Logo" style="height: 48px; width: 48px; object-fit: contain; border-radius: 50%;" class="border shadow-sm" onerror="this.src='/images/rnb-logo.jpg'" />
                <div>
                    <span class="fw-bold text-dark fs-5">@Model.School.Name</span>
                    <small class="d-block text-muted" style="font-size: 0.75rem;">Affiliated & Registered: @(Model.School.RegistrationNumber ?? "REG-BH-BHOJPUR-802207")</small>
                </div>
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small d-none d-md-inline fw-semibold">
                    <i class="bi bi-telephone-fill text-primary me-1"></i> Helpline: 094708 35418
                </span>
                <a href="/School/Register/@Model.School.Code" class="btn btn-success btn-sm px-3 fw-bold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Online Admission
                </a>
            </div>
        </div>
    </nav>

    <!-- Hero Section with Official School Photo & Emblem -->
    <section class="hero-banner text-center">
        <div class="container">
            <div class="school-hero-img-box">
                <img src="/uploads/schools/rnb-logo.jpg" alt="R N B Public School Emblem" onerror="this.src='/images/rnb-logo.jpg'" />
            </div>
            <span class="badge bg-warning text-dark px-3 py-2 text-uppercase mb-3 fw-bold">Admissions Open 2026-27</span>
            <h1 class="display-4 fw-extrabold mb-2">Welcome to @Model.School.Name</h1>
            <h4 class="mb-3" style="font-family: 'Tiro Devanagari Hindi', sans-serif; color: #fde047;">आर एन बी पब्लिक स्कूल, पिरो</h4>
            <p class="lead max-w-2xl mx-auto opacity-90 mb-4" style="max-width: 750px;">
                @(Model.School.About ?? "Best School In Bhojpur • Excellence in Education • Holistic Development")
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a href="/School/Register/@Model.School.Code" class="btn btn-warning px-4 py-2 fw-bold shadow">
                    <i class="bi bi-pencil-square me-1"></i> Online Admission Registration
                </a>
                <a href="#about" class="btn btn-outline-light px-4 py-2 fw-semibold">Explore Campus</a>
                <a href="#contact" class="btn btn-primary px-4 py-2 fw-semibold shadow">Contact Administration</a>
            </div>
        </div>
    </section>

    <!-- KPI Strength Row -->
    <div class="container mb-5">
        <div class="stat-badge-card">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3">
                    <div class="display-6 fw-bold text-primary">@Model.TotalStudents+</div>
                    <div class="text-muted small fw-semibold text-uppercase">Active Students</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="display-6 fw-bold text-success">@Model.TotalTeachers+</div>
                    <div class="text-muted small fw-semibold text-uppercase">Expert Faculty</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="display-6 fw-bold text-info">@Model.TotalClasses</div>
                    <div class="text-muted small fw-semibold text-uppercase">Academic Grades</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="display-6 fw-bold text-warning">100%</div>
                    <div class="text-muted small fw-semibold text-uppercase">Excellence Track</div>
                </div>
            </div>
        </div>
    </div>

    <!-- About & Showcase Section -->
    <section class="py-5" id="about">
        <div class="container">
            <!-- Large Showcase Photo Card -->
            <div class="card border-0 shadow-sm p-4 p-md-5 bg-white mb-5">
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 text-center">
                        <div class="p-3 bg-light rounded-4 border shadow-sm">
                            <img src="/uploads/schools/rnb-logo.jpg" alt="R N B Public School Campus" style="width: 100%; max-height: 280px; object-fit: contain; border-radius: 12px;" onerror="this.src='/images/rnb-logo.jpg'" />
                        </div>
                    </div>
                    <div class="col-md-7">
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 mb-2">About Our Institution</span>
                        <h2 class="fw-bold mb-3">Excellence In Learning & Holistic Child Development</h2>
                        <p class="text-muted" style="line-height: 1.8;">
                            R N B Public School, Piro (आर एन बी पब्लिक स्कूल पिरो) is recognized as one of the finest educational institutions in Bhojpur district. We provide comprehensive English-medium schooling from Nursery to Class 10, combining state-of-the-art interactive smart classrooms, well-equipped science and computer laboratories, dedicated sports coaching, and strong moral values.
                        </p>
                        <div class="row g-3 mt-2">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold small">Smart Digital Classrooms</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold small">Experienced Faculty</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold small">Sports & Cultural Activities</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold small">Computer & Science Labs</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-4 h-100 bg-white border-start border-4 border-primary">
                        <div class="feature-icon-circle bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-eye-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Our Vision</h4>
                        <p class="text-muted mb-0">
                            @(Model.School.Vision ?? "To inspire every student with lifelong learning, ethical integrity, and global leadership skills in Piro and Bhojpur.")
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-4 h-100 bg-white border-start border-4 border-success">
                        <div class="feature-icon-circle bg-success bg-opacity-10 text-success">
                            <i class="bi bi-compass-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Our Mission</h4>
                        <p class="text-muted mb-0">
                            @(Model.School.Mission ?? "Empowering diverse minds through state-of-the-art educational practices, moral values, and holistic development.")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Principal Message -->
            @if (Model.Principal != null)
            {
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white mb-5">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-4 text-center">
                            <div class="avatar-img avatar-xl mx-auto mb-3 border bg-light d-flex align-items-center justify-content-center overflow-hidden" style="width: 140px; height: 140px;">
                                @if (!string.IsNullOrEmpty(Model.Principal.Photo))
                                {
                                    <img src="@Model.Principal.Photo" alt="Principal" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-badge fs-1 text-primary"></i>
                                }
                            </div>
                            <h5 class="fw-bold mb-1">@Model.Principal.Name</h5>
                            <div class="text-primary small fw-semibold">Principal / Head of Institute</div>
                            <small class="text-muted">@Model.Principal.Qualification</small>
                        </div>
                        <div class="col-md-8">
                            <h3 class="fw-bold mb-3">From the Desk of the Principal</h3>
                            <blockquote class="blockquote text-muted fs-6 mb-3" style="line-height: 1.8;">
                                <i class="bi bi-quote fs-3 text-primary"></i>
                                @(Model.Principal.Message ?? "Welcome to R N B Public School, Piro! We are committed to providing top-quality education with disciplined learning, modern smart classrooms, and holistic child development in Bhojpur.")
                            </blockquote>
                            <div class="small text-muted">
                                <strong>Experience:</strong> @(Model.Principal.Experience ?? "Over 20 years in educational leadership")
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Campus Gallery -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">Campus Life & Gallery</h3>
                        <p class="text-muted small mb-0">Experience world-class infrastructure and dynamic learning spaces</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="gallery-card card border-0 shadow-sm overflow-hidden h-100">
                            <img src="/uploads/schools/rnb-logo.jpg" alt="Official Emblem" onerror="this.src='/images/rnb-logo.jpg'" />
                            <div class="card-body p-2">
                                <div class="fw-semibold small text-truncate">Official School Emblem</div>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">Campus</span>
                            </div>
                        </div>
                    </div>
                    @foreach (var img in Model.GalleryImages.Where(i => i.ImagePath != "/uploads/schools/rnb-logo.jpg"))
                    {
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="gallery-card card border-0 shadow-sm overflow-hidden h-100">
                                <img src="@img.ImagePath" alt="@img.Title" />
                                <div class="card-body p-2">
                                    <div class="fw-semibold small text-truncate">@img.Title</div>
                                    <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">@img.Category</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Contact & Location -->
            <div class="card border-0 shadow-sm p-4 bg-white" id="contact">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h4 class="fw-bold mb-3">Get in Touch</h4>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="bi bi-geo-alt-fill text-primary fs-4"></i>
                            <div>
                                <div class="fw-semibold">Campus Address</div>
                                <div class="text-muted small">8CM3+PH4, Piro, Bhojpur, Bihar 802207</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="bi bi-telephone-fill text-primary fs-4"></i>
                            <div>
                                <div class="fw-semibold">Contact Numbers</div>
                                <div class="text-muted small">
                                    <a href="tel:+919470835418" class="text-decoration-none text-dark fw-bold">094708 35418</a> / 
                                    <a href="tel:+919661160546" class="text-decoration-none text-dark fw-bold">09661160546</a>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="bi bi-facebook text-primary fs-4"></i>
                            <div>
                                <div class="fw-semibold">Facebook Page</div>
                                <div class="text-muted small">
                                    <a href="https://www.facebook.com/RNBPublicSchool/" target="_blank" class="text-decoration-none text-primary">facebook.com/RNBPublicSchool</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-light p-4 rounded-3 h-100 d-flex flex-column justify-content-center border">
                            <h5 class="fw-bold mb-2">Are you a Student or Faculty Member?</h5>
                            <p class="text-muted small mb-3">Access attendance, class dashboards, results, notices, and profile records.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary fw-semibold px-4 py-2 align-self-start shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to ERP Portal
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1 fw-bold">@Model.School.Name</p>
            <small class="text-white-50 d-block mb-3">8CM3+PH4, Piro, Bhojpur, Bihar 802207 • Phone: 094708 35418 / 09661160546</small>
            <small class="text-white-50">&copy; @DateTime.Today.Year @Model.School.Name. All rights reserved.</small>
        </div>
    </footer>
</body>
</html>
