@model SchoolManagement.ViewModels.SchoolPublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.School.Name} - Official Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-IN" prefix="og: https://ogp.me/ns#">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>@Model.School.Name, Piro | Best English Medium CBSE School in Bhojpur Bihar</title>
    <meta name="title" content="@Model.School.Name, Piro | Best English Medium CBSE School in Bhojpur Bihar" />
    <meta name="description" content="Welcome to @Model.School.Name, Piro (Bhojpur, Bihar). Leading co-educational institution providing holistic quality education from Nursery to Class 10 with Smart Classrooms, Science & Computer Labs, Sports, and Experienced Faculty. Admissions Open 2026-2027!" />
    <meta name="keywords" content="RNB Public School, RNB School Piro, Best school in Piro, Schools in Bhojpur Bihar, CBSE English Medium school Piro, RNB Public School Admission, Best co-ed school in Bhojpur, Top school in Piro Bihar, RNB Piro, Education in Bhojpur" />
    <meta name="author" content="@Model.School.Name Administration" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code" />

    <!-- Official School Favicons -->
    <link rel="icon" type="image/jpeg" href="~/images/rnb-logo.jpg" />
    <link rel="shortcut icon" type="image/jpeg" href="~/images/rnb-logo.jpg" />
    <link rel="apple-touch-icon" href="~/images/rnb-logo.jpg" />

    <!-- Geo & Local SEO Meta Tags -->
    <meta name="geo.region" content="IN-BR" />
    <meta name="geo.placename" content="Piro, Bhojpur, Bihar" />
    <meta name="geo.position" content="25.3315;84.4124" />
    <meta name="ICBM" content="25.3315, 84.4124" />

    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content="school" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="@Model.School.Name, Piro" />
    <meta property="og:title" content="@Model.School.Name, Piro — Admissions Open 2026-27" />
    <meta property="og:description" content="Explore quality education, modern labs, sports, and smart classrooms at @Model.School.Name, Piro. Apply online for admission today!" />
    <meta property="og:url" content="https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code" />
    <meta property="og:image" content="https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg" />
    <meta property="og:image:alt" content="@Model.School.Name Campus & Official Emblem" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.School.Name, Piro (Bhojpur)" />
    <meta name="twitter:description" content="Premier English Medium Co-educational institution in Piro, Bhojpur, Bihar. Admissions Open 2026-2027." />
    <meta name="twitter:image" content="https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Schema.org JSON-LD Structured Data for School & Local Business -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": ["School", "EducationalOrganization"],
      "name": "@Model.School.Name",
      "legalName": "@Model.School.Name",
      "description": "Leading English Medium co-educational institution in Piro, Bhojpur, Bihar offering holistic education from Nursery to Class 10.",
      "url": "https://rnbpublicschool.com/School/PublicProfile/@Model.School.Code",
      "logo": "https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg",
      "image": "https://rnbpublicschool.com/uploads/schools/rnb-logo.jpg",
      "telephone": "+91-9470835418",
      "email": "info@rnbpublicschool.com",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Station Road, 8CM3+PH4",
        "addressLocality": "Piro",
        "addressRegion": "Bihar",
        "postalCode": "802207",
        "addressCountry": "IN"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": 25.3315,
        "longitude": 84.4124
      },
      "openingHoursSpecification": [
        {
          "@@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "07:30",
          "closes": "14:00"
        }
      ]
    }
    </script>

    <style>
        :root {
            --brand-navy: #0f172a;
            --brand-blue: #1e40af;
            --brand-accent: #2563eb;
            --brand-gold: #f59e0b;
            --brand-gold-glow: #fbbf24;
            --brand-green: #10b981;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #334155;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Outfit', sans-serif;
            letter-spacing: -0.02em;
        }

        /* Top Announcement Header */
        .top-bar {
            background: #090d16;
            color: #cbd5e1;
            font-size: 0.8rem;
            padding: 0.4rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        /* Sticky Glass Navbar */
        .glass-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            transition: all 0.3s ease;
        }

        .nav-link {
            font-weight: 600;
            font-size: 0.88rem;
            color: #475569 !important;
            padding: 0.5rem 0.85rem !important;
            transition: color 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--brand-accent) !important;
        }

        /* Premium Hero Section */
        .hero-section {
            position: relative;
            background: linear-gradient(135deg, #0b1329 0%, #172554 50%, #1e3a8a 100%);
            color: #ffffff;
            padding: 5rem 0 6.5rem;
            overflow: hidden;
        }

        .hero-pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 24px 24px;
            opacity: 0.6;
        }

        .hero-glow-1 {
            position: absolute;
            width: 500px;
            height: 500px;
            top: -100px;
            left: -100px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, transparent 70%);
            border-radius: 50%;
            filter: blur(40px);
        }

        .hero-glow-2 {
            position: absolute;
            width: 450px;
            height: 450px;
            bottom: -50px;
            right: -50px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            filter: blur(40px);
        }

        .school-emblem-badge {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #ffffff;
            padding: 5px;
            box-shadow: 0 0 35px rgba(245, 158, 11, 0.45);
            border: 3px solid #fbbf24;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.4s ease;
        }

        .school-emblem-badge:hover {
            transform: scale(1.05) rotate(3deg);
        }

        .school-emblem-badge img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 50%;
        }

        /* Floating KPI Stats Bar */
        .stats-floating-container {
            margin-top: -3.5rem;
            position: relative;
            z-index: 10;
        }

        .stats-card {
            background: #ffffff;
            border-radius: 1.25rem;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.12);
            border: 1px solid #e2e8f0;
            padding: 1.5rem 1rem;
        }

        .stat-item {
            border-right: 1px solid #f1f5f9;
        }
        .stat-item:last-child {
            border-right: none;
        }

        /* Section Titles */
        .section-tag {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.35rem 0.85rem;
            border-radius: 50rem;
            margin-bottom: 0.65rem;
        }

        /* Modern Feature Cards */
        .facility-card {
            background: #ffffff;
            border-radius: 1rem;
            padding: 1.5rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
            height: 100%;
        }

        .facility-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -10px rgba(37, 99, 235, 0.15);
            border-color: #cbd5e1;
        }

        .facility-icon-wrap {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        /* Academic Wings */
        .wing-card {
            background: #ffffff;
            border-radius: 1.25rem;
            padding: 2rem 1.5rem;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .wing-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
        }

        .wing-card.wing-1::before { background: #3b82f6; }
        .wing-card.wing-2::before { background: #10b981; }
        .wing-card.wing-3::before { background: #f59e0b; }

        .wing-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.08);
        }

        /* Gallery Filter & Cards */
        .gallery-filter-btn {
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #64748b;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.45rem 1rem;
            border-radius: 50rem;
            transition: all 0.2s ease;
        }

        .gallery-filter-btn:hover, .gallery-filter-btn.active {
            background: var(--brand-accent);
            color: #ffffff;
            border-color: var(--brand-accent);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        .gallery-item-card {
            border-radius: 1rem;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            transition: all 0.35s ease;
            position: relative;
        }

        .gallery-item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -8px rgba(15, 23, 42, 0.15);
        }

        .gallery-img-container {
            height: 200px;
            overflow: hidden;
            position: relative;
            background: #f1f5f9;
        }

        .gallery-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-item-card:hover .gallery-img-container img {
            transform: scale(1.08);
        }

        /* Principal Quote Card */
        .principal-desk-card {
            background: #ffffff;
            border-radius: 1.5rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 15px 35px -10px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        /* Floating Quick Contact on Mobile */
        .floating-mobile-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            box-shadow: 0 -5px 25px rgba(0,0,0,0.12);
            z-index: 1000;
            padding: 0.6rem 1rem;
            border-top: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>

    <!-- TOP ANNOUNCEMENT & CONTACT BAR -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4">
                <span>
                    <i class="bi bi-geo-alt-fill text-warning me-1"></i> Station Road, Piro, Bhojpur (Bihar) 802207
                </span>
                <span>
                    <i class="bi bi-clock-fill text-info me-1"></i> Mon - Sat: 07:30 AM - 02:00 PM
                </span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:+919470835418" class="text-light text-decoration-none fw-semibold">
                    <i class="bi bi-telephone-fill text-success me-1"></i> +91 94708 35418
                </a>
                <span class="text-white-50">|</span>
                <a href="https://www.instagram.com/rnbpublicschoolpiro/" target="_blank" class="text-light text-decoration-none" title="Follow us on Instagram">
                    <i class="bi bi-instagram text-danger"></i>
                </a>
                <a href="https://www.facebook.com/RNBPublicSchool/" target="_blank" class="text-light text-decoration-none" title="Follow us on Facebook">
                    <i class="bi bi-facebook text-primary"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN NAVIGATION BAR -->
    <nav class="navbar navbar-expand-lg glass-navbar sticky-top py-2.5">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2.5" href="#">
                <img src="/uploads/schools/rnb-logo.jpg" alt="R N B Public School Emblem" style="height: 46px; width: 46px; object-fit: contain; border-radius: 50%;" class="border shadow-sm" onerror="this.src='/images/rnb-logo.jpg'" />
                <div>
                    <span class="fw-bolder text-dark fs-5 d-block line-height-1">@Model.School.Name</span>
                    <small class="text-muted" style="font-size: 0.72rem;">
                        <span class="fw-semibold text-primary">Piro (Bhojpur)</span> • Reg: @(Model.School.RegistrationNumber ?? "REG-BH-BHOJPUR-802207")
                    </small>
                </div>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="#about">About School</a></li>
                    <li class="nav-item"><a class="nav-link" href="#wings">Academics</a></li>
                    <li class="nav-item"><a class="nav-link" href="#facilities">Campus & Labs</a></li>
                    <li class="nav-item"><a class="nav-link" href="#gallery">Photo Gallery</a></li>
                    <li class="nav-item"><a class="nav-link" href="#principal">Principal's Desk</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm px-3 fw-semibold rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Staff ERP
                    </a>
                    <a href="/School/Register/@Model.School.Code" class="btn btn-warning btn-sm px-3.5 py-1.5 fw-bold rounded-pill shadow-sm text-dark">
                        <i class="bi bi-pencil-square me-1"></i> Admissions 2026-27
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO BANNER SECTION -->
    <header class="hero-section text-center">
        <div class="hero-pattern"></div>
        <div class="hero-glow-1"></div>
        <div class="hero-glow-2"></div>

        <div class="container position-relative">
            <!-- Center Emblem with Golden Glow -->
            <div class="mb-3">
                <div class="school-emblem-badge">
                    <img src="/uploads/schools/rnb-logo.jpg" alt="R N B Public School Emblem" onerror="this.src='/images/rnb-logo.jpg'" />
                </div>
            </div>

            <!-- Admission Pill -->
            <div class="mb-2">
                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.04em;">
                    <i class="bi bi-stars me-1"></i> ADMISSIONS OPEN FOR SESSION 2026 – 2027
                </span>
            </div>

            <!-- Titles -->
            <h1 class="display-4 fw-extrabold mb-1 text-white">
                @Model.School.Name
            </h1>
            <h3 class="fw-normal mb-3" style="font-family: 'Tiro Devanagari Hindi', sans-serif; color: #fde047; font-size: 1.6rem;">
                आर एन बी पब्लिक स्कूल, पिरो (भोजपुर)
            </h3>

            <p class="lead text-light opacity-90 mx-auto mb-4" style="max-width: 780px; font-size: 1.08rem; line-height: 1.7;">
                @(Model.School.About ?? "Leading co-educational English-medium institution committed to academic excellence, digital smart classrooms, STEM science labs, athletic training, and high moral character in Bhojpur, Bihar.")
            </p>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center flex-wrap gap-2.5 mb-2">
                <a href="/School/Register/@Model.School.Code" class="btn btn-warning btn-lg px-4 py-2.5 fw-bold text-dark shadow rounded-pill" style="font-size: 0.95rem;">
                    <i class="bi bi-pencil-fill me-1.5"></i> Apply Online for Admission
                </a>
                <a href="#gallery" class="btn btn-outline-light btn-lg px-4 py-2.5 fw-semibold rounded-pill" style="font-size: 0.95rem;">
                    <i class="bi bi-images me-1.5"></i> Explore Campus Life
                </a>
                <a href="tel:+919470835418" class="btn btn-primary btn-lg px-4 py-2.5 fw-semibold rounded-pill shadow" style="font-size: 0.95rem; background: #2563eb;">
                    <i class="bi bi-telephone-fill me-1.5"></i> Helpline: 094708 35418
                </a>
            </div>
        </div>
    </header>

    <!-- FLOATING STATS KPI BAR -->
    <div class="container stats-floating-container">
        <div class="stats-card">
            <div class="row g-2 text-center">
                <div class="col-6 col-md-3 stat-item">
                    <div class="display-6 fw-extrabold text-primary mb-0">@(Model.TotalStudents > 0 ? Model.TotalStudents : 500)+</div>
                    <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.72rem;">Enrolled Scholars</div>
                </div>
                <div class="col-6 col-md-3 stat-item">
                    <div class="display-6 fw-extrabold text-success mb-0">@(Model.TotalTeachers > 0 ? Model.TotalTeachers : 25)+</div>
                    <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.72rem;">Expert Educators</div>
                </div>
                <div class="col-6 col-md-3 stat-item">
                    <div class="display-6 fw-extrabold text-info mb-0">Nursery - 10th</div>
                    <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.72rem;">Academic Wings</div>
                </div>
                <div class="col-6 col-md-3 stat-item">
                    <div class="display-6 fw-extrabold text-warning mb-0">100%</div>
                    <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.72rem;">CBSE Aligned Quality</div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN BODY SECTIONS -->
    <main class="py-5">
        <div class="container">

            <!-- OFFICIAL ADMISSION BANNER HIGHLIGHT -->
            <div class="mb-5 rounded-4 overflow-hidden shadow-sm border">
                <img src="/uploads/gallery/fb-admission-banner.jpg" alt="RNB Public School Admissions Open 2026-27" class="w-100" style="max-height: 380px; object-fit: cover;" onerror="this.style.display='none'" />
            </div>

            <!-- ABOUT & CAMPUS OVERVIEW -->
            <section class="mb-5 pt-3" id="about">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-5">
                        <div class="position-relative">
                            <div class="rounded-4 overflow-hidden shadow-lg border">
                                <img src="/uploads/gallery/fb-photo-1.jpg" alt="RNB Campus Activities" class="w-100" style="height: 380px; object-fit: cover;" onerror="this.src='/images/gallery-campus.png'" />
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-3 p-3 bg-white bg-opacity-95 rounded-3 shadow-sm border" style="max-width: 260px;">
                                <div class="fw-bold text-dark small"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Station Road, Piro</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Lush Green Campus & Modern Academic Blocks</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 ps-lg-4">
                        <span class="section-tag bg-primary-subtle text-primary">About Our Institution</span>
                        <h2 class="display-6 fw-bold text-dark mb-3">
                            Nurturing Future Leaders With Knowledge & Character
                        </h2>
                        <p class="text-muted mb-3" style="line-height: 1.8; font-size: 0.95rem;">
                            <strong>R N B Public School, Piro (आर एन बी पब्लिक स्कूल, पिरो)</strong> is one of the most trusted and prestigious co-educational institutions in Bhojpur, Bihar. With modern digital pedagogical methods, passionate educators, and vibrant extracurricular opportunities, we empower young minds from early childhood to high school graduation.
                        </p>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2.5 p-2.5 bg-white rounded-3 border shadow-xs">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark small">Smart Interactive Boards</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2.5 p-2.5 bg-white rounded-3 border shadow-xs">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark small">High-Tech Science & Robotics Lab</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2.5 p-2.5 bg-white rounded-3 border shadow-xs">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark small">Computer Lab & Digital Skills</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2.5 p-2.5 bg-white rounded-3 border shadow-xs">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark small">Sports Arena, Yoga & Martial Arts</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
