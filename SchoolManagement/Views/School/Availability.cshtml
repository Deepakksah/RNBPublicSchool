@model SchoolManagement.ViewModels.SchoolAvailabilityViewModel
@{
    ViewData["Title"] = "School Availability & Status Dashboard";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">School Availability & Operational Status</h4>
        <p class="text-muted small mb-0">Real-time attendance readiness and open status across schools</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active</span>
        <span class="badge bg-warning text-dark"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Warning</span>
        <span class="badge bg-danger"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Inactive</span>
    </div>
</div>

<div class="row g-4">
    @foreach (var s in Model.Schools)
    {
        var badgeColor = s.Status == SchoolManagement.Models.SchoolStatus.Active ? "bg-success" :
                         s.Status == SchoolManagement.Models.SchoolStatus.UnderMaintenance ? "bg-warning text-dark" : "bg-danger";

        <div class="col-md-6 col-xl-4">
            <div class="card card-custom h-100 p-4 border-top border-4 @(s.Status == SchoolManagement.Models.SchoolStatus.Active ? "border-success" : "border-warning")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">@s.SchoolName</h5>
                        <span class="badge bg-light text-secondary border">@s.SchoolCode</span>
                    </div>
                    <span class="badge @badgeColor">@s.Status</span>
                </div>

                <div class="mb-3 p-3 bg-light rounded-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">School Today:</span>
                        @if (s.IsOpenToday)
                        {
                            <span class="badge bg-success-subtle text-success fw-bold"><i class="bi bi-door-open-fill me-1"></i>OPEN</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger fw-bold"><i class="bi bi-door-closed-fill me-1"></i>CLOSED</span>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Attendance Rate:</span>
                        <strong class="text-primary">@s.AttendanceRate%</strong>
                    </div>
                </div>

                <div class="row g-2 text-center small mb-3">
                    <div class="col-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">Students</span>
                            <strong class="text-dark">@s.PresentStudentsToday / @s.TotalStudents</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">Faculty</span>
                            <strong class="text-dark">@s.PresentTeachersToday / @s.TotalTeachers</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">Classes</span>
                            <strong class="text-dark">@s.TotalClasses</strong>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-3 border-top d-flex justify-content-between">
                    <a asp-controller="Dashboard" asp-action="Index" asp-route-schoolId="@s.SchoolId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                    <a href="/School/Profile/@s.SchoolCode" target="_blank" class="btn btn-sm btn-light border">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Public
                    </a>
                </div>
            </div>
        </div>
    }
</div>
