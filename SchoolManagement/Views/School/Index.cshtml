@model IEnumerable<SchoolManagement.Models.School>
@{
    ViewData["Title"] = "Registered Schools";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Registered Schools</h4>
        <p class="text-muted small mb-0">Multi-tenant institute configuration & administration</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-plus-lg"></i>
            <span>Register New School</span>
        </a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>School Name</th>
                    <th>Code</th>
                    <th>City & State</th>
                    <th>Principal</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-light p-1 rounded border" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(s.Logo))
                                    {
                                        <img src="@s.Logo" alt="Logo" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-building text-primary"></i>
                                    }
                                </div>
                                <div>
                                    <div class="fw-bold">@s.Name</div>
                                    <small class="text-muted">Est. @s.EstablishedYear</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@s.Code</span></td>
                        <td>@s.City, @s.State</td>
                        <td>@(s.Principal?.Name ?? "<em>Not Appointed</em>")</td>
                        <td>
                            <div class="small">@s.Phone</div>
                            <small class="text-muted">@s.Email</small>
                        </td>
                        <td>
                            @if (s.Status == SchoolManagement.Models.SchoolStatus.Active)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning">@s.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    Manage
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id"><i class="bi bi-eye me-2"></i>Profile & Details</a></li>
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil me-2"></i>Edit Information</a></li>
                                    <li><a class="dropdown-item" href="/School/Profile/@s.Code" target="_blank"><i class="bi bi-globe me-2"></i>Public Website</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Are you sure you want to deactivate this school?');">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Deactivate</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
