@model IEnumerable<SchoolManagement.Models.SystemSetting>
@{
    ViewData["Title"] = "System Settings";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">System & Attendance Parameters</h4>
        <p class="text-muted small mb-0">Configure global ERP variables, timing tolerances, and timezone policies</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom p-4">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <table class="table table-borderless align-middle mb-4">
                    <thead>
                        <tr class="border-bottom">
                            <th style="width: 35%;">Parameter / Setting</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@s.SettingKey</div>
                                    <small class="text-muted">@s.Description</small>
                                </td>
                                <td>
                                    <input type="text" name="settings[@s.SettingKey]" value="@s.SettingValue" class="form-control form-control-sm" required />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-save me-1"></i> Save Configuration
                </button>
            </form>
        </div>
    </div>
</div>
