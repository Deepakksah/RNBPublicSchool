@model SchoolManagement.ViewModels.TeacherCreateEditViewModel
@{
    ViewData["Title"] = "Register Faculty Member";
}

<!-- Top Action Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-1.5 mb-2 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-light border text-muted py-0.5 px-2"><i class="bi bi-arrow-left"></i></a>
            <h5 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">Register Faculty Member — Faculty Desk</h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0.5 px-2" style="font-size: 0.72rem;">Academic Staff</span>
        </div>
        <div class="text-muted small" style="font-size: 0.74rem;">Enter teacher credentials, educational qualifications, subjects, and classroom role.</div>
    </div>
    <div class="d-flex gap-1.5 mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-1 px-2.5 d-flex align-items-center gap-1" style="font-size: 0.78rem;">
            <i class="bi bi-people"></i> Faculty Directory
        </a>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="teacherCreateForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-2"></div>

    <div class="row g-2 mb-3">
        <!-- LEFT COLUMN: MAIN FORM DATA (70%) -->
        <div class="col-lg-8">
            <!-- 1. PERSONAL & QUALIFICATION -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary small">
                        <i class="bi bi-person-badge-fill me-1"></i> 1. Personal & Professional Qualification
                    </span>
                    <span class="badge bg-primary text-white" style="font-size: 0.68rem;">Step 1</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label small fw-semibold text-muted">Teacher Full Name *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-primary"></i></span>
                                <input asp-for="Name" class="form-control form-control-sm fw-bold" id="teacherNameInput" placeholder="e.g. Ramesh Kumar Verma" required autofocus autocomplete="off" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EmployeeId" class="form-label small fw-semibold text-muted">Employee ID *</label>
                            <input asp-for="EmployeeId" class="form-control form-control-sm fw-bold text-uppercase text-primary bg-light" id="teacherEmpInput" placeholder="e.g. T-106" required />
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label small fw-semibold text-muted">Gender *</label>
                            <select asp-for="Gender" class="form-select form-select-sm" id="teacherGenderSelect" required>
                                <option value="Male">👨 Male</option>
                                <option value="Female">👩 Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label small fw-semibold text-muted">Date of Birth *</label>
                            <input asp-for="DateOfBirth" class="form-control form-control-sm" type="date" required />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Qualification" class="form-label small fw-semibold text-muted">Highest Qualification *</label>
                            <input asp-for="Qualification" class="form-control form-control-sm fw-semibold" id="teacherQualInput" placeholder="e.g. M.Sc, B.Ed" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Experience" class="form-label small fw-semibold text-muted">Teaching Experience</label>
                            <input asp-for="Experience" class="form-control form-control-sm" id="teacherExpInput" placeholder="e.g. 6 Years" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. DESIGNATION & CLASSROOM ASSIGNMENT -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success small">
                        <i class="bi bi-briefcase-fill me-1"></i> 2. Designation, Subject & Classroom Role
                    </span>
                    <span class="badge bg-success text-white" style="font-size: 0.68rem;">Step 2</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label asp-for="Designation" class="form-label small fw-semibold text-muted">Designation *</label>
                            <input asp-for="Designation" class="form-control form-control-sm fw-bold text-dark" id="teacherDesigInput" placeholder="e.g. Senior Teacher" required />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Subject" class="form-label small fw-semibold text-muted">Primary Subject *</label>
                            <input asp-for="Subject" class="form-control form-control-sm fw-semibold text-primary" id="teacherSubjInput" placeholder="e.g. Science" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedSectionId" class="form-label small fw-semibold text-muted">Class Teacher Role</label>
                            <select asp-for="AssignedSectionId" asp-items="Model.Sections" class="form-select form-select-sm fw-semibold" id="teacherSecSelect">
                                <option value="">-- None / Subject Teacher --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label small fw-semibold text-muted">Date of Joining *</label>
                            <input asp-for="JoiningDate" class="form-control form-control-sm" type="date" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-muted">Employment Status</label>
                            <select asp-for="Status" class="form-select form-select-sm fw-semibold">
                                <option value="1">Active In-Service</option>
                                <option value="2">Inactive</option>
                                <option value="3">Resigned</option>
                                <option value="4">On Leave</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CONTACT & RESIDENTIAL ADDRESS -->
            <div class="card card-custom mb-2">
                <div class="card-header-custom py-1.5 px-3 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-warning-emphasis small">
                        <i class="bi bi-telephone-fill me-1"></i> 3. Contact Numbers & Address
                    </span>
                    <span class="badge bg-warning text-dark" style="font-size: 0.68rem;">Step 3</span>
                </div>
                <div class="card-body p-2.5">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Mobile" class="form-label small fw-semibold text-muted">Mobile Number (WhatsApp) *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-success"></i></span>
                                <input asp-for="Mobile" class="form-control form-control-sm fw-bold" id="teacherMobileInput" maxlength="10" placeholder="10-digit mobile" required />
                            </div>
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted">Official / Personal Email *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-primary"></i></span>
                                <input asp-for="Email" class="form-control form-control-sm" id="teacherEmailInput" placeholder="teacher@rnb.edu" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-muted">Residential Address *</label>
                            <input asp-for="Address" class="form-control form-control-sm" placeholder="Village / Ward / City" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: LIVE TEACHER ID CARD PREVIEW (30%) -->
        <div class="col-lg-4">
            <!-- Faculty Live ID Card Widget -->
            <div class="card card-custom mb-2 border-primary shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0f9ff 100%);">
                <div class="card-header py-1.5 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0b0f19 0%, #1e3a8a 100%); border-top-left-radius: 6px; border-top-right-radius: 6px;">
                    <div class="d-flex align-items-center gap-1.5">
                        <img src="/uploads/schools/rnb-logo.jpg" style="width: 22px; height: 22px; border-radius: 50%; background: #fff;" onerror="this.src='/images/rnb-logo.jpg'" />
                        <span class="fw-bold small" style="font-family: 'Outfit', sans-serif;">R N B PUBLIC SCHOOL</span>
                    </div>
                    <span class="badge bg-warning text-dark py-0.5 px-1.5" style="font-size: 0.65rem;">FACULTY ID</span>
                </div>
                <div class="card-body p-3 text-center">
                    <!-- Photo Circle with live preview & upload overlay -->
                    <div class="position-relative mx-auto mb-2" style="width: 82px; height: 82px;">
                        <div class="avatar-preview-box rounded-circle shadow-sm border border-2 border-primary overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 82px; height: 82px;">
                            <img id="teacherPhotoPreview" src="/images/avatars/teacher-m2.svg" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <label for="teacherPhotoInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-1 shadow cursor-pointer" style="width: 26px; height: 26px; font-size: 0.75rem; cursor: pointer;" title="Upload Photo">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                    </div>

                    <!-- Hidden actual file input -->
                    <input asp-for="PhotoFile" class="d-none" type="file" accept="image/*" id="teacherPhotoInput" />

                    <!-- Live Teacher Name & Badges -->
                    <h6 class="fw-bold text-dark mb-0" id="cardTeacherName" style="font-family: 'Outfit', sans-serif;">Faculty Name</h6>
                    <div class="text-muted small mb-2" style="font-size: 0.72rem;">
                        <span class="badge bg-primary-subtle text-primary border me-1" id="cardTeacherDesig">Teacher</span>
                        <span class="badge bg-success-subtle text-success border" id="cardTeacherSubj">Subject</span>
                    </div>

                    <!-- Compact ID Details Grid -->
                    <div class="bg-white rounded border p-2 text-start small mb-2" style="font-size: 0.74rem;">
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Employee ID:</span>
                            <span class="fw-bold text-primary" id="cardTeacherEmp">--</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Qualification:</span>
                            <span class="fw-semibold text-dark text-truncate" id="cardTeacherQual" style="max-width: 130px;">--</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Class Teacher:</span>
                            <span class="fw-semibold text-success text-truncate" id="cardTeacherClass" style="max-width: 130px;">None</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5">
                            <span class="text-muted">Mobile:</span>
                            <span class="fw-bold text-dark" id="cardTeacherMobile">--</span>
                        </div>
                    </div>

                    <div class="text-muted" style="font-size: 0.68rem;">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Station Road, Piro, Bhojpur (Bihar)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DOCKED STICKY ACTION BUTTON BAR -->
    <div class="card card-custom p-2 bg-white border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 sticky-bottom shadow">
        <a asp-action="Index" class="btn btn-light border btn-sm py-1 px-3 text-muted" style="font-size: 0.78rem;">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary btn-sm py-1.5 px-4 fw-bold shadow-sm" style="font-size: 0.8rem;">
            <i class="bi bi-person-check-fill me-1"></i> Register Faculty Member
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateCard() {
                var name = $('#teacherNameInput').val().trim();
                var emp = $('#teacherEmpInput').val().trim();
                var desig = $('#teacherDesigInput').val().trim();
                var subj = $('#teacherSubjInput').val().trim();
                var qual = $('#teacherQualInput').val().trim();
                var mobile = $('#teacherMobileInput').val().trim();
                var secText = $('#teacherSecSelect option:selected').text();

                $('#cardTeacherName').text(name || 'Faculty Name');
                $('#cardTeacherEmp').text(emp || '--');
                $('#cardTeacherDesig').text(desig || 'Teacher');
                $('#cardTeacherSubj').text(subj || 'Subject');
                $('#cardTeacherQual').text(qual || '--');
                $('#cardTeacherMobile').text(mobile || '--');
                $('#cardTeacherClass').text(secText.includes('None') ? 'None' : secText);
            }

            $('#teacherNameInput, #teacherEmpInput, #teacherDesigInput, #teacherSubjInput, #teacherQualInput, #teacherMobileInput').on('input', updateCard);
            $('#teacherSecSelect').on('change', updateCard);

            $('#teacherPhotoInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (event) {
                        $('#teacherPhotoPreview').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            updateCard();
        });
    </script>
}
