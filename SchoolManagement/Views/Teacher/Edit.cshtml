@model SchoolManagement.ViewModels.TeacherCreateEditViewModel
@{
    ViewData["Title"] = $"Edit Faculty — {Model.Name}";
}

<!-- Top Action Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-1 mb-1.5 border-bottom">
    <div class="d-flex align-items-center gap-1.5">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-light border text-muted py-0.5 px-1.5" style="font-size: 0.72rem;"><i class="bi bi-arrow-left"></i></a>
        <h6 class="fw-bold mb-0 text-dark" style="font-family: 'Outfit', sans-serif;">Edit Faculty Information — @Model.Name</h6>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0.5 px-1.5" style="font-size: 0.68rem;">Emp ID: @Model.EmployeeId</span>
    </div>
    <div class="d-flex gap-1 mt-1 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-0.5 px-2 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
            <i class="bi bi-people"></i> Directory
        </a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm py-0.5 px-2 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
            <i class="bi bi-person-badge"></i> Profile
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="teacherEditForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SchoolId" />
    <input type="hidden" asp-for="ExistingPhoto" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-1.5"></div>

    <div class="row g-1.5 mb-2">
        <!-- LEFT COLUMN: MAIN FORM DATA (72%) -->
        <div class="col-lg-8">
            <!-- 1. PERSONAL & QUALIFICATION -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary" style="font-size: 0.74rem;">
                        <i class="bi bi-person-badge-fill me-1"></i> 1. Personal & Qualification
                    </span>
                    <span class="badge bg-primary text-white py-0 px-1" style="font-size: 0.62rem;">Step 1</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-5">
                            <label asp-for="Name" class="form-label text-muted">Teacher Full Name *</label>
                            <input asp-for="Name" class="form-control form-control-sm fw-bold" id="teacherNameInput" placeholder="Teacher name" required autofocus autocomplete="off" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EmployeeId" class="form-label text-muted">Employee ID *</label>
                            <input asp-for="EmployeeId" class="form-control form-control-sm fw-bold text-uppercase text-primary bg-light" id="teacherEmpInput" required />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Gender" class="form-label text-muted">Gender *</label>
                            <select asp-for="Gender" class="form-select form-select-sm" id="teacherGenderSelect" required>
                                <option value="Male">👨 Male</option>
                                <option value="Female">👩 Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="DateOfBirth" class="form-label text-muted">Date of Birth *</label>
                            <input asp-for="DateOfBirth" class="form-control form-control-sm" type="date" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Qualification" class="form-label text-muted">Highest Qualification *</label>
                            <input asp-for="Qualification" class="form-control form-control-sm fw-semibold" id="teacherQualInput" placeholder="e.g. M.Sc, B.Ed" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Experience" class="form-label text-muted">Teaching Experience</label>
                            <input asp-for="Experience" class="form-control form-control-sm" id="teacherExpInput" placeholder="e.g. 5 Years" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. DESIGNATION & CLASSROOM ROLE -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success" style="font-size: 0.74rem;">
                        <i class="bi bi-briefcase-fill me-1"></i> 2. Designation, Subject & Classroom
                    </span>
                    <span class="badge bg-success text-white py-0 px-1" style="font-size: 0.62rem;">Step 2</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-4">
                            <label asp-for="Designation" class="form-label text-muted">Designation *</label>
                            <input asp-for="Designation" class="form-control form-control-sm fw-bold text-dark" id="teacherDesigInput" placeholder="e.g. Senior Teacher" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Subject" class="form-label text-muted">Primary Subject *</label>
                            <input asp-for="Subject" class="form-control form-control-sm fw-semibold text-primary" id="teacherSubjInput" placeholder="e.g. Mathematics" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedSectionId" class="form-label text-muted">Class Teacher Role</label>
                            <select asp-for="AssignedSectionId" asp-items="Model.Sections" class="form-select form-select-sm fw-semibold" id="teacherSecSelect">
                                <option value="">-- None / Subject Teacher --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label text-muted">Joining Date *</label>
                            <input asp-for="JoiningDate" class="form-control form-control-sm" type="date" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label text-muted">Employment Status</label>
                            <select asp-for="Status" class="form-select form-select-sm fw-semibold">
                                <option value="1">Active In-Service</option>
                                <option value="2">Inactive</option>
                                <option value="3">Resigned</option>
                                <option value="4">On Extended Leave</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CONTACT & RESIDENTIAL ADDRESS -->
            <div class="card card-custom mb-1.5">
                <div class="card-header-compact py-1 px-2.5 bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-warning-emphasis" style="font-size: 0.74rem;">
                        <i class="bi bi-telephone-fill me-1"></i> 3. Contact & Address
                    </span>
                    <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.62rem;">Step 3</span>
                </div>
                <div class="card-body p-2">
                    <div class="row g-1.5">
                        <div class="col-md-4">
                            <label asp-for="Mobile" class="form-label text-muted">Mobile (WhatsApp) *</label>
                            <input asp-for="Mobile" class="form-control form-control-sm fw-bold text-dark" id="teacherMobileInput" maxlength="10" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label text-muted">Email *</label>
                            <input asp-for="Email" class="form-control form-control-sm" id="teacherEmailInput" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Address" class="form-label text-muted">Address *</label>
                            <input asp-for="Address" class="form-control form-control-sm" placeholder="Village / City" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: COMPACT LIVE TEACHER ID CARD PREVIEW (28%) -->
        <div class="col-lg-4">
            <!-- Faculty Live ID Card Widget -->
            <div class="card card-custom mb-1.5 border-primary shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0f9ff 100%);">
                <div class="card-header py-1 px-2.5 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0b0f19 0%, #1e3a8a 100%); border-top-left-radius: 4px; border-top-right-radius: 4px;">
                    <div class="d-flex align-items-center gap-1">
                        <img src="/uploads/schools/rnb-logo.jpg" style="width: 18px; height: 18px; border-radius: 50%; background: #fff;" onerror="this.src='/images/rnb-logo.jpg'" />
                        <span class="fw-bold" style="font-size: 0.72rem; font-family: 'Outfit', sans-serif;">R N B PUBLIC SCHOOL</span>
                    </div>
                    <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.6rem;">FACULTY ID</span>
                </div>
                <div class="card-body p-2 text-center">
                    <!-- Photo Circle with live preview & upload overlay -->
                    <div class="position-relative mx-auto mb-1.5" style="width: 68px; height: 68px;">
                        <div class="avatar-preview-box rounded-circle shadow-sm border border-2 border-primary overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 68px; height: 68px;">
                            <img id="teacherPhotoPreview" src="@(string.IsNullOrEmpty(Model.ExistingPhoto) ? "/images/avatars/teacher-m1.svg" : Model.ExistingPhoto)" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <label for="teacherPhotoInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle shadow cursor-pointer d-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.68rem; cursor: pointer;" title="Change Photo">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                    </div>

                    <!-- Hidden actual file input -->
                    <input asp-for="PhotoFile" class="d-none" type="file" accept="image/*" id="teacherPhotoInput" />

                    <!-- Live Teacher Name & Badges -->
                    <h6 class="fw-bold text-dark mb-0 text-truncate" id="cardTeacherName" style="font-size: 0.84rem; font-family: 'Outfit', sans-serif;">@Model.Name</h6>
                    <div class="text-muted mb-1.5" style="font-size: 0.68rem;">
                        <span class="badge bg-primary-subtle text-primary border py-0 px-1 me-1" id="cardTeacherDesig">@(Model.Designation ?? "Teacher")</span>
                        <span class="badge bg-success-subtle text-success border py-0 px-1" id="cardTeacherSubj">@(Model.Subject ?? "General")</span>
                    </div>

                    <!-- Compact ID Details Grid -->
                    <div class="bg-white rounded border p-1.5 text-start mb-1.5" style="font-size: 0.70rem;">
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Emp ID:</span>
                            <span class="fw-bold text-primary" id="cardTeacherEmp">@Model.EmployeeId</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Qual:</span>
                            <span class="fw-semibold text-dark text-truncate" id="cardTeacherQual" style="max-width: 120px;">@(Model.Qualification ?? "--")</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5 border-bottom">
                            <span class="text-muted">Class Teacher:</span>
                            <span class="fw-semibold text-success text-truncate" id="cardTeacherClass" style="max-width: 120px;">Assigned</span>
                        </div>
                        <div class="d-flex justify-content-between py-0.5">
                            <span class="text-muted">Mobile:</span>
                            <span class="fw-bold text-dark" id="cardTeacherMobile">@Model.Mobile</span>
                        </div>
                    </div>

                    <div class="text-muted" style="font-size: 0.64rem;">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Station Road, Piro, Bhojpur (Bihar)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DOCKED STICKY ACTION BUTTON BAR -->
    <div class="card card-custom p-1.5 bg-white border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-1.5 sticky-bottom shadow-sm">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border btn-sm py-0.5 px-2.5 text-muted" style="font-size: 0.74rem;">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary btn-sm py-1 px-3.5 fw-bold shadow-sm" style="font-size: 0.78rem;">
            <i class="bi bi-check2-circle me-1"></i> Save Faculty Changes
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateCard() {
                var name = $('#teacherNameInput').val().trim();
                var emp = $('#teacherEmpInput').val().trim();
                var desig = $('#teacherDesigInput').val().trim();
                var subj = $('#teacherSubjInput').val().trim();
                var qual = $('#teacherQualInput').val().trim();
                var mobile = $('#teacherMobileInput').val().trim();
                var secText = $('#teacherSecSelect option:selected').text();

                $('#cardTeacherName').text(name || 'Teacher Name');
                $('#cardTeacherEmp').text(emp || '--');
                $('#cardTeacherDesig').text(desig || 'Teacher');
                $('#cardTeacherSubj').text(subj || 'Teacher');
                $('#cardTeacherQual').text(qual || '--');
                $('#cardTeacherMobile').text(mobile || '--');
                $('#cardTeacherClass').text(secText.includes('None') ? 'None' : secText);
            }

            $('#teacherNameInput, #teacherEmpInput, #teacherDesigInput, #teacherSubjInput, #teacherQualInput, #teacherMobileInput').on('input', updateCard);
            $('#teacherSecSelect').on('change', updateCard);

            $('#teacherPhotoInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (event) {
                        $('#teacherPhotoPreview').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            updateCard();
        });
    </script>
}
