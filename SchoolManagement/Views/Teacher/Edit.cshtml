@model SchoolManagement.ViewModels.TeacherCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Edit Faculty Information</h4>
        <p class="text-muted small mb-0">Employee ID: <strong>@Model.EmployeeId</strong></p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Profile
    </a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SchoolId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="row g-4">
        <!-- Personal & Qualification -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="bi bi-person-badge-fill me-2"></i>Personal & Qualification</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold small"></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-semibold small"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EmployeeId" class="form-label fw-semibold small"></label>
                        <input asp-for="EmployeeId" class="form-control text-uppercase" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold small"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PhotoFile" class="form-label fw-semibold small"></label>
                        <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ExistingPhoto))
                        {
                            <div class="mt-2"><img src="@Model.ExistingPhoto" alt="Current Photo" style="height: 40px; border-radius: 50%;" /></div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Qualification" class="form-label fw-semibold small"></label>
                        <input asp-for="Qualification" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Experience" class="form-label fw-semibold small"></label>
                        <input asp-for="Experience" class="form-control" />
                    </div>
                </div>

                <h5 class="fw-bold my-4 border-bottom pb-2 text-primary"><i class="bi bi-telephone me-2"></i>Contact Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Mobile" class="form-label fw-semibold small"></label>
                        <input asp-for="Mobile" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <input asp-for="Address" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <!-- Role & Assignment -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="bi bi-briefcase me-2"></i>Designation & Subject</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Designation" class="form-label fw-semibold small"></label>
                        <input asp-for="Designation" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small"></label>
                        <input asp-for="Subject" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="AssignedSectionId" class="form-label fw-semibold small"></label>
                        <select asp-for="AssignedSectionId" asp-items="Model.Sections" class="form-select">
                            <option value="">-- None / Not Assigned --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="JoiningDate" class="form-label fw-semibold small"></label>
                        <input asp-for="JoiningDate" class="form-control" type="date" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">Active</option>
                            <option value="2">Inactive</option>
                            <option value="3">Resigned</option>
                            <option value="4">On Leave</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-save me-1"></i> Update Faculty
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
