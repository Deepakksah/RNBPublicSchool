@model SchoolManagement.Models.AcademicYear
@{
    ViewData["Title"] = "Add Academic Year";
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">Create Academic Year</h4>
        <p class="text-muted small mb-0">Set start and end dates for the academic session</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. 2026-27" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold small">Session Start</label>
                        <input asp-for="StartDate" class="form-control" type="date" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold small">Session End</label>
                        <input asp-for="EndDate" class="form-control" type="date" required />
                    </div>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="IsCurrent" class="form-check-input" />
                    <label asp-for="IsCurrent" class="form-check-label small fw-semibold">Set as currently active academic year</label>
                </div>

                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Save Academic Year
                </button>
            </form>
        </div>
    </div>
</div>
